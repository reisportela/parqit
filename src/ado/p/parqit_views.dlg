/*
  parqit view - Manage views, run DuckDB SQL, and set engine options

*!  VERSION 0.7.0  27oct2026

  User > parqit > Views, SQL, and engine settings...
  Launch directly with:  db parqit_views      (menu installed by: parqit menu)

  The report buttons run at once with the dialog open (views, show, explain,
  describe, ds, version, selftest), echoed to the Results window like a typed
  command. The list box chooses the action that OK or Submit runs: switch,
  close, or close every view; run a parqit command on another view; copy a
  view's plan into a new view; open a view from a DuckDB SQL query or add a
  raw SQL fragment to the current pipeline; or change any of the eight parqit
  session settings.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 370
INCLUDE header
HELP hlp1, view("help parqit##settings")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call main.lb_op.forceselchange
	call program main_context
END

DIALOG main, label("parqit view - Manage views, run DuckDB SQL, and set engine options") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  GROUPBOX gb_report		_lft	45	_iwd	_ht2h,		///
	label("Report on the selected view now (the dialog stays open)")
  BUTTON bu_views		_ilft	_ss	70	.,		///
	onpush(program rep_views)					///
	tooltip("List the open views (parqit views)")			///
	label("Views")
  BUTTON bu_show		95	@	80	.,		///
	onpush(program rep_show)					///
	tooltip("Print the SQL the pipeline compiles to (parqit show)")	///
	label("Show SQL")
  BUTTON bu_explain		180	@	70	.,		///
	onpush(program rep_explain)					///
	tooltip("Print the engine's query plan (parqit explain)")	///
	label("Explain")
  BUTTON bu_desc		255	@	80	.,		///
	onpush(program rep_describe)					///
	tooltip("Describe the view's schema and pipeline depth (parqit describe)") ///
	label("Describe")
  BUTTON bu_ds			340	@	80	.,		///
	onpush(program rep_ds)						///
	tooltip("List the variable names (parqit ds)")			///
	label("Variables")
  BUTTON bu_version		425	@	70	.,		///
	onpush(program rep_version)					///
	tooltip("Report the parqit, DuckDB, and plugin-interface versions (parqit version)") ///
	label("Version")
  BUTTON bu_selftest		500	@	80	.,		///
	onpush(program rep_selftest)					///
	tooltip("End-to-end engine and codec check (parqit selftest)")	///
	label("Self-test")

  TEXT tx_op			_lft	95	290	.,		///
	label("Action:")
  LISTBOX lb_op			_lft	_ss	290	180,		///
	contents(op_words)						///
	values(op_vals)							///
	onselchangelist(op_change)					///
	label("Action")

  TEXT tx_name			315	95	275	.,		///
	label("View name:")
  EDIT ed_name			315	_ss	_vnwd	.,		///
	max(32)								///
	label("View name")

  TEXT tx_cmd			315	_ls	275	.,		///
	label("Command to run on it (e.g., count):")
  EDIT ed_cmd			315	_ss	275	.,		///
	label("Command")

  TEXT tx_value			315	_ls	275	.,		///
	label("Value:")
  COMBOBOX cb_sm		315	_ss	_vnwd	.,		///
	dropdownlist							///
	contents(sm_list)						///
	default("on")							///
	label("statamissing")
  EDIT ed_value			315	@	275	.,		///
	label("Value")
  COMBOBOX cb_int64 315 @ _vnwd ., dropdownlist contents(i64_list) ///
	default("refuse") label("Integer precision policy")
  COMBOBOX cb_encset 315 @ _vnwd ., dropdown contents(encset_list) ///
	default("windows-1252") label("Code page of undeclared text")
  EDIT ed_newname		315	@	_vnwd	.,		///
	max(32)								///
	label("Name of the new view")
  CHECKBOX ck_tsclear		315	_ls	275	.,		///
	option(clear)							///
	onclickon(program ts_clear_state)				///
	onclickoff(program ts_clear_state)				///
	label("Remove the declaration instead (clear)")
  TEXT tx_context _lft 325 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_refresh)
END

DIALOG opt, tabtitle("SQL")
BEGIN
  TEXT tx_sql _lft _top _iwd ., label("DuckDB SQL:")
  EDIT ed_sql _lft _ss _iwd ., label("DuckDB SQL")
  CHECKBOX ck_sqlclear _lft _ls _iwd ., option(clear) ///
	onclickon(program sql_name_state) onclickoff(program sql_name_state) ///
	label("Load the result into memory (clear)")
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

LIST sm_list
BEGIN
	on
	off
END

LIST i64_list
BEGIN
	refuse
	round
	string
END

LIST encset_list
BEGIN
	windows-1252
	latin1
	latin9
	macroman
	windows-1250
	windows-1251
	windows-1253
	windows-1254
	windows-1255
	windows-1256
	windows-1257
	windows-1258
	windows-874
	koi8-r
	koi8-u
	ibm866
	iso-8859-2
	iso-8859-5
	iso-8859-7
	shift_jis
	euc-jp
	gbk
	gb18030
	big5
	euc-kr
	utf-8
END

LIST op_words
BEGIN
	Switch to a view (view)
	Close a view (close)
	Close every view (close _all)
	Run a command on another view (view name:)
	Copy a view into a new view (use ... using view:)
	Open a view from a DuckDB SQL query (sql)
	Add a SQL fragment to the pipeline (query)
	Declare panel and time variables (xtset)
	Declare a time variable (tsset)
	Set missing-value mode (set statamissing)
	Set integer precision (set int64)
	Set the code page of undeclared text (set encoding)
	Set engine threads (set threads)
	Set fill workers (set fill_threads)
	Set result buffer (set stream_buffer_mb)
	Set memory limit (set memory_limit)
	Set spill directory (set tempdir)
END

LIST op_vals
BEGIN
	switch
	close
	closeall
	run
	copy
	sql
	query
	xtset
	tsset
	statamissing
	int64
	encoding
	threads
	fill_threads
	stream_buffer_mb
	memory_limit
	tempdir
END

LIST op_change
BEGIN
	script op_switch
	script op_close
	script op_closeall
	script op_run
	script op_copy
	script op_sql
	script op_query
	script op_xtset
	script op_tsset
	script op_statamissing
	script op_int64
	script op_encoding
	script op_threads
	script op_fill_threads
	script op_stream_buffer
	script op_memory
	script op_tempdir
END

SCRIPT all_off
BEGIN
	main.tx_view.disable
	main.cb_view.disable
	main.bu_show.disable
	main.bu_explain.disable
	main.bu_desc.disable
	main.bu_ds.disable
	main.tx_name.disable
	main.ed_name.disable
	main.tx_cmd.disable
	main.ed_cmd.disable
	opt.tx_sql.disable
	opt.ed_sql.disable
	opt.ck_sqlclear.disable
	main.tx_value.disable
	main.cb_sm.hide
	main.cb_int64.hide
	main.cb_encset.hide
	main.ed_value.hide
	main.ed_value.enable
	main.ed_newname.hide
	main.ck_tsclear.hide
	main.tx_name.setlabel "View name:"
	main.tx_cmd.setlabel "Command to run on it (e.g., count):"
	opt.tx_sql.setlabel "DuckDB SQL:"
	main.tx_value.setlabel "Value:"
	program main_refresh
END

SCRIPT view_on
BEGIN
	main.tx_view.enable
	main.cb_view.enable
	main.bu_show.enable
	main.bu_explain.enable
	main.bu_desc.enable
	main.bu_ds.enable
END

SCRIPT op_switch
BEGIN
	script all_off
	script view_on
END

SCRIPT op_close
BEGIN
	script all_off
	script view_on
END

SCRIPT op_closeall
BEGIN
	script all_off
END

SCRIPT op_run
BEGIN
	script all_off
	script view_on
	main.tx_cmd.enable
	main.ed_cmd.enable
END

SCRIPT op_copy
BEGIN
	script all_off
	script view_on
	main.tx_cmd.enable
	main.ed_cmd.enable
	main.tx_cmd.setlabel "Variables to keep (blank = all):"
	main.tx_value.enable
	main.tx_value.setlabel "Name of the new view:"
	main.ed_newname.show
END

SCRIPT op_xtset
BEGIN
	script all_off
	script view_on
	main.tx_name.enable
	main.ed_name.enable
	main.tx_name.setlabel "Panel variable:"
	main.tx_cmd.enable
	main.ed_cmd.enable
	main.tx_cmd.setlabel "Time variable (integer-valued; L. F. D. S. work by time):"
	main.tx_value.enable
	main.tx_value.setlabel "Delta, periods between observations (optional):"
	main.ed_value.show
	main.ck_tsclear.show
	program ts_clear_state
END

SCRIPT op_tsset
BEGIN
	script all_off
	script view_on
	main.tx_cmd.enable
	main.ed_cmd.enable
	main.tx_cmd.setlabel "Time variable (integer-valued; L. F. D. S. work by time):"
	main.tx_value.enable
	main.tx_value.setlabel "Delta, periods between observations (optional):"
	main.ed_value.show
	main.ck_tsclear.show
	program ts_clear_state
END

PROGRAM ts_clear_state
BEGIN
	if main.ck_tsclear {
		call main.tx_name.disable
		call main.ed_name.disable
		call main.tx_cmd.disable
		call main.ed_cmd.disable
		call main.tx_value.disable
		call main.ed_value.disable
	}
	else {
		if main.lb_op.equals("xtset") {
			call main.tx_name.enable
			call main.ed_name.enable
		}
		call main.tx_cmd.enable
		call main.ed_cmd.enable
		call main.tx_value.enable
		call main.ed_value.enable
	}
END

SCRIPT op_sql
BEGIN
	script all_off
	main.tx_name.enable
	main.tx_name.setlabel "Name of the view to open (optional):"
	opt.tx_sql.enable
	opt.ed_sql.enable
	opt.ck_sqlclear.enable
	program sql_name_state
END

PROGRAM sql_name_state
BEGIN
	if opt.ck_sqlclear {
		call main.ed_name.disable
	}
	else {
		call main.ed_name.enable
	}
END

SCRIPT op_query
BEGIN
	script all_off
	script view_on
	opt.tx_sql.enable
	opt.ed_sql.enable
	opt.tx_sql.setlabel "SQL fragment appended to the selected view's pipeline:"
END

SCRIPT op_statamissing
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Mode: on = Stata ordering, off = SQL:"
	main.cb_sm.show
END

SCRIPT op_threads
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Number of engine threads:"
	main.ed_value.show
END

SCRIPT op_int64
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Integers beyond 2^53:"
	main.cb_int64.show
END

SCRIPT op_encoding
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Code page of text that declares none:"
	main.cb_encset.show
END

SCRIPT op_fill_threads
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Fill workers (auto or count; 1 = serial):"
	main.ed_value.setvalue "auto"
	main.ed_value.show
END

SCRIPT op_stream_buffer
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Buffer MB (auto, 0 = engine default, or MB):"
	main.ed_value.setvalue "auto"
	main.ed_value.show
END

SCRIPT op_memory
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Memory limit (DuckDB size, e.g., 8GB):"
	main.ed_value.show
END

SCRIPT op_tempdir
BEGIN
	script all_off
	main.tx_value.enable
	main.tx_value.setlabel "Spill directory (may be created later):"
	main.ed_value.show
END

PROGRAM rep_views
BEGIN
	put "parqit views"
	stata
END

PROGRAM rep_show
BEGIN
	call program main_require
	put "parqit view " main.cb_view ": show"
	stata
END

PROGRAM rep_explain
BEGIN
	call program main_require
	put "parqit view " main.cb_view ": explain"
	stata
END

PROGRAM rep_describe
BEGIN
	call program main_require
	put "parqit view " main.cb_view ": describe"
	stata
END

PROGRAM rep_ds
BEGIN
	call program main_require
	put "parqit view " main.cb_view ": ds"
	stata
END

PROGRAM rep_version
BEGIN
	put "parqit version"
	stata
END

PROGRAM rep_selftest
BEGIN
	put "parqit selftest"
	stata
END

PROGRAM command
BEGIN
	if main.lb_op.equals("switch") | main.lb_op.equals("close") | main.lb_op.equals("run") | ///
	   main.lb_op.equals("copy") | main.lb_op.equals("query") | main.lb_op.equals("xtset") | main.lb_op.equals("tsset") {
		call program main_require
	}
	if main.lb_op.equals("switch") {
		put "parqit view " main.cb_view
	}
	if main.lb_op.equals("close") {
		put "parqit close " main.cb_view
	}
	if main.lb_op.equals("closeall") {
		put "parqit close _all"
	}
	if main.lb_op.equals("run") {
		require main.ed_cmd
		put "parqit view " main.cb_view ": " main.ed_cmd
	}
	if main.lb_op.equals("copy") {
		require main.ed_newname
		put "parqit view " main.cb_view ": use "
		if main.ed_cmd {
			put main.ed_cmd " "
		}
		put "using view:" main.cb_view ", name(" main.ed_newname ")"
	}
	if main.lb_op.equals("sql") {
		require opt.ed_sql
		put "parqit sql "
		put /smartquote opt.ed_sql
		beginoptions
			option opt.ck_sqlclear
			if !opt.ck_sqlclear {
				if main.ed_name {
					put "name(" main.ed_name ")"
				}
			}
		endoptions
	}
	if main.lb_op.equals("query") {
		require opt.ed_sql
		put "parqit view " main.cb_view ": query "
		put /smartquote opt.ed_sql
	}
	if main.lb_op.equals("xtset") {
		if main.ck_tsclear {
			put "parqit view " main.cb_view ": xtset"
			beginoptions
				option main.ck_tsclear
			endoptions
		}
		else {
			require main.ed_name
			require main.ed_cmd
			put "parqit view " main.cb_view ": xtset " main.ed_name " " main.ed_cmd
			beginoptions
				if main.ed_value {
					put "delta(" main.ed_value ")"
				}
			endoptions
		}
	}
	if main.lb_op.equals("tsset") {
		if main.ck_tsclear {
			put "parqit view " main.cb_view ": tsset"
			beginoptions
				option main.ck_tsclear
			endoptions
		}
		else {
			require main.ed_cmd
			put "parqit view " main.cb_view ": tsset " main.ed_cmd
			beginoptions
				if main.ed_value {
					put "delta(" main.ed_value ")"
				}
			endoptions
		}
	}
	if main.lb_op.equals("statamissing") {
		put "parqit set statamissing " main.cb_sm
	}
	if main.lb_op.equals("int64") {
		put "parqit set int64 " main.cb_int64
	}
	if main.lb_op.equals("encoding") {
		require main.cb_encset
		put "parqit set encoding " main.cb_encset
	}
	if main.lb_op.equals("threads") {
		require main.ed_value
		put "parqit set threads " main.ed_value
	}
	if main.lb_op.equals("fill_threads") {
		require main.ed_value
		put "parqit set fill_threads " main.ed_value
	}
	if main.lb_op.equals("stream_buffer_mb") {
		require main.ed_value
		put "parqit set stream_buffer_mb " main.ed_value
	}
	if main.lb_op.equals("memory_limit") {
		require main.ed_value
		put "parqit set memory_limit " main.ed_value
	}
	if main.lb_op.equals("tempdir") {
		require main.ed_value
		put "parqit set tempdir "
		put /smartquote main.ed_value
	}
END
