/*
  parqit save - Write Parquet or collect a view into memory

*!  VERSION 0.8.2  28oct2026

  User > parqit > Save as Parquet or collect into memory...
  Launch directly with:  db parqit_write      (menu installed by: parqit menu)

  The two materialisers: parqit collect executes the selected view's pipeline
  once and replaces the data in memory atomically; parqit save executes it
  and writes Parquet directly (or, with data, writes the dataset in memory).
  The fourth choice converts an SPSS file (.sav, .zsav) or an R data file
  (.rds, .rda, .RData) to Parquet with parqit save <file> using <file>,
  extended missing codes included; object() names the R data frame to read
  when the file holds several.
  As in Stata's own save dialogs, an existing file asks before being replaced.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 395
INCLUDE header
HELP hlp1, view("help parqit##materialisers")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_view_live
	create STRING pq_view_name
	create DOUBLE pq_refreshing
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit save - Write Parquet or collect a view into memory") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  RADIO rb_save		_lft	45	_iwd	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Write the selected view to Parquet (save)")
  RADIO rb_data _lft _ss _iwd ., onclickon(program main_mode) ///
	label("Write the dataset in Stata memory to Parquet (save, data)")
  RADIO rb_spss _lft _ss _iwd ., onclickon(program main_mode) ///
	label("Convert an SPSS file (.sav, .zsav) or R data (.rds, .rda, .RData) to Parquet (save ... using)")
  RADIO rb_collect _lft _ss _iwd ., last onclickon(program main_mode) ///
	label("Load the selected view into Stata memory (collect)")
  CHECKBOX ck_repl		_ilft	_ss	_ibwd	.,		///
	option(clear)							///
	label("Replace data in memory even when they have unsaved changes (clear)")
  CHECKBOX ck_compress		_ilft	_ss	_ibwd	.,		///
	option(compress)						///
	label("Narrow the storage types losslessly after loading, as compress does (compress)")

  TEXT tx_spss			_ilft	_ls	250	.,		///
	label("SPSS or R file to convert:")
  TEXT tx_obj			300	@	120	.,		///
	label("R object (optional):")
  TEXT tx_spenc			440	@	140	.,		///
	label("Code page of its text:")
  FILE fi_spss			_ilft	_ss	250	.,		///
	error("SPSS or R file")						///
	filter("SPSS or R|*.sav;*.zsav;*.rds;*.rda;*.RData|SPSS|*.sav;*.zsav|R|*.rds;*.rda;*.RData|All files|*.*") ///
	label("Browse...")
  EDIT ed_obj			300	@	120	.,		///
	option(object)							///
	tooltip("The data frame to read when an .RData (or a list saved in an .rds) holds several; leave empty otherwise") ///
	label("R object")
  COMBOBOX cb_spenc		440	@	140	.,		///
	dropdown							///
	contents(spenc_list)						///
	default("declared")						///
	option(encoding)						///
	tooltip("declared uses the code page the SPSS file records, or the encoding R recorded; pick or type another only when that record is missing or wrong") ///
	label("Code page")

  TEXT tx_out			_ilft	_ls	_ibwd	.,		///
	label("Filename (a directory when partitioning):")
  FILE fi_out			@	_ss	@	.,		///
	error("Filename")						///
	defext(parquet)							///
	save								///
	filter("Parquet (*.parquet)|*.parquet|All files (*.*)|*.*")	///
	label("Save as...")
  CHECKBOX ck_replace		@	_ls	@	.,		///
	option(replace)							///
	label("Overwrite an existing file or partition directory (replace)")
  CHECKBOX ck_copy		@	_ss	@	.,		///
	option(copysource)						///
	label("Copy the source file of the last parqit use ..., clear instead of reading memory (copysource)")
  CHECKBOX ck_xmiss		@	_ss	@	.,		///
	option(xmissing)						///
	label("Preserve extended missing values .a-.z in companion columns (xmissing)")

  TEXT tx_context _lft 355 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_refresh)
END

DIALOG opt, tabtitle("Storage and partitions")
BEGIN
  TEXT tx_comp			_ilft	_top	120	.,		///
	label("Compression:")
  TEXT tx_level			160	@	120	.,		///
	label("Compression level:")
  TEXT tx_chunk			300	@	160	.,		///
	label("Rows per row group:")
  COMBOBOX cb_comp		_ilft	_ss	120	.,		///
	dropdownlist							///
	contents(comp_list)						///
	default("zstd")							///
	option(compression)						///
	label("Compression")
  EDIT ed_level			160	@	80	.,		///
	numonly								///
	option(compression_level)					///
	label("Compression level")
  EDIT ed_chunk			300	@	100	.,		///
	numonly								///
	option(chunk)							///
	label("Rows per row group")

  TEXT tx_part			_ilft	_ls	_ilw80	.,		///
	label("Partition by these variables into a Hive directory tree, partition_by() (optional):")
  BUTTON bu_pop			_rj80	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate from the selected view, or from the dataset in memory when data is selected") ///
	label("Populate")
  COMBOBOX cb_part		_ilft	_ss	_ibwd	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	option(partition_by)						///
	label("Partition by")
  TEXT tx_pmode			_ilft	_ls	_ibwd	.,		///
	label("Existing partitions when partitioning, partitions(): rewrite the whole tree (none), replace or append")
  COMBOBOX cb_pmode		@	_ss	_vnwd	.,		///
	dropdownlist							///
	contents(pmode_list)						///
	default("none")							///
	option(partitions)						///
	onselchange(program main_mode)					///
	label("Existing partitions")

  TEXT tx_enc			_ilft	_ls	_ibwd	.,		///
	label("Code page of legacy (non-UTF-8) text when the dataset in memory is written:")
  COMBOBOX cb_enc		@	_ss	_vnwd	.,		///
	dropdown							///
	contents(enc_list)						///
	default("default")						///
	option(encoding)						///
	tooltip("default: the session code page (windows-1252 unless parqit set encoding); pick or type any encoding parqit reads (add , all for text that is valid UTF-8 by accident)") ///
	label("Code page")
  TEXT tx_int64 _ilft _ls 300 ., label("Large integers on collect (default = inherit):")
  COMBOBOX cb_int64 330 @ 140 ., dropdownlist contents(i64_list) ///
	default("default") option(int64) label("Integers beyond 2^53") ///
	tooltip("default inherits the view/session setting; string keeps exact digits, round accepts loss, refuse stops the load")
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

LIST vv_list
BEGIN
END

LIST comp_list
BEGIN
	zstd
	snappy
	gzip
	lz4
	lz4_raw
	brotli
	uncompressed
END

LIST pmode_list
BEGIN
	none
	replace
	append
END

LIST enc_list
BEGIN
	default
	windows-1252
	latin1
	latin9
	macroman
	windows-1250
	windows-1251
	windows-1253
	windows-1254
	windows-1255
	windows-1256
	windows-1257
	windows-1258
	windows-874
	koi8-r
	koi8-u
	ibm866
	iso-8859-2
	iso-8859-5
	iso-8859-7
	shift_jis
	euc-jp
	gbk
	gb18030
	big5
	euc-kr
	utf-8
END

LIST spenc_list
BEGIN
	declared
	utf-8
	windows-1252
	latin1
	latin9
	macroman
	windows-1250
	windows-1251
	windows-1253
	windows-1254
	windows-1255
	windows-1256
	windows-1257
	windows-1258
	windows-874
	koi8-r
	koi8-u
	ibm866
	iso-8859-2
	iso-8859-5
	iso-8859-7
	shift_jis
	euc-jp
	gbk
	gb18030
	big5
	euc-kr
END

LIST i64_list
BEGIN
	default
	refuse
	round
	string
END

PROGRAM main_mode
BEGIN
	if main.rb_data | main.rb_spss {
		call main.tx_view.disable
		call main.cb_view.disable
	}
	else {
		call main.tx_view.enable
		call main.cb_view.enable
	}
	if main.rb_collect {
		call main.ck_repl.enable
		call main.ck_compress.enable
		call opt.tx_int64.enable
		call opt.cb_int64.enable
		call main.tx_out.disable
		call main.fi_out.disable
		call main.ck_replace.disable
		call main.ck_copy.disable
		call main.ck_xmiss.disable
		call opt.tx_comp.disable
		call opt.cb_comp.disable
		call opt.tx_level.disable
		call opt.ed_level.disable
		call opt.tx_chunk.disable
		call opt.ed_chunk.disable
		call opt.tx_part.disable
		call opt.bu_pop.disable
		call opt.cb_part.disable
		call opt.tx_pmode.disable
		call opt.cb_pmode.disable
		call opt.tx_enc.disable
		call opt.cb_enc.disable
		call main.tx_spss.disable
		call main.fi_spss.disable
		call main.tx_obj.disable
		call main.ed_obj.disable
		call main.tx_spenc.disable
		call main.cb_spenc.disable
		call main.tx_out.setlabel "Filename (a directory when partitioning):"
	}
	if main.rb_save | main.rb_data {
		call main.ck_repl.disable
		call main.ck_compress.disable
		call opt.tx_int64.disable
		call opt.cb_int64.disable
		call main.tx_spss.disable
		call main.fi_spss.disable
		call main.tx_obj.disable
		call main.ed_obj.disable
		call main.tx_spenc.disable
		call main.cb_spenc.disable
		call main.tx_out.setlabel "Filename (a directory when partitioning):"
		call main.tx_out.enable
		call main.fi_out.enable
		call main.ck_replace.enable
		call opt.tx_comp.enable
		call opt.cb_comp.enable
		call opt.tx_level.enable
		call opt.ed_level.enable
		call opt.tx_chunk.enable
		call opt.ed_chunk.enable
		call opt.tx_part.enable
		call opt.bu_pop.enable
		call opt.cb_part.enable
		call opt.tx_pmode.enable
		call opt.cb_pmode.enable
		if main.rb_data {
			call opt.tx_enc.enable
			call opt.cb_enc.enable
			call main.ck_copy.enable
			call main.ck_xmiss.enable
		}
		else {
			call opt.tx_enc.disable
			call opt.cb_enc.disable
			call main.ck_copy.setoff
			call main.ck_copy.disable
			call main.ck_xmiss.setoff
			call main.ck_xmiss.disable
		}
		if !opt.cb_pmode.isdefault() {
			call main.ck_replace.setoff
			call main.ck_replace.disable
		}
	}
	if main.rb_spss {
		call main.ck_repl.disable
		call main.ck_compress.disable
		call opt.tx_int64.disable
		call opt.cb_int64.disable
		call main.tx_spss.enable
		call main.fi_spss.enable
		call main.tx_obj.enable
		call main.ed_obj.enable
		call main.tx_spenc.enable
		call main.cb_spenc.enable
		call main.tx_out.setlabel "Parquet file to write:"
		call main.tx_out.enable
		call main.fi_out.enable
		call main.ck_replace.enable
		call main.ck_copy.setoff
		call main.ck_copy.disable
		call main.ck_xmiss.setoff
		call main.ck_xmiss.disable
		call opt.tx_comp.enable
		call opt.cb_comp.enable
		call opt.tx_level.enable
		call opt.ed_level.enable
		call opt.tx_chunk.disable
		call opt.ed_chunk.disable
		call opt.tx_part.disable
		call opt.bu_pop.disable
		call opt.cb_part.disable
		call opt.tx_pmode.disable
		call opt.cb_pmode.disable
		call opt.tx_enc.disable
		call opt.cb_enc.disable
	}
	call program main_refresh
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM command
BEGIN
	if !main.rb_data & !main.rb_spss {
		call program main_require
	}
	if main.rb_collect {
		put "parqit view " main.cb_view ": collect"
		beginoptions
			option main.ck_repl
			option main.ck_compress
			optionarg /hidedefault opt.cb_int64
		endoptions
	}
	if main.rb_save | main.rb_data {
		require main.fi_out
		if !main.ck_replace & opt.cb_pmode.isdefault() {
			repfile main.fi_out
		}
		if main.rb_data {
			put "parqit save "
		}
		else {
			put "parqit view " main.cb_view ": save "
		}
		put /smartquote main.fi_out
		beginoptions
			if opt.cb_pmode.isdefault() {
				if main.ck_replace | main.fi_out.repfile {
					put "replace "
				}
			}
			optionarg /hidedefault opt.cb_comp
			optionarg opt.ed_level
			optionarg opt.cb_part
			optionarg /hidedefault opt.cb_pmode
			optionarg opt.ed_chunk
			optionarg /hidedefault opt.cb_enc
			if main.rb_data {
				put "data "
			}
			else {
				put "view "
			}
			option main.ck_copy
			option main.ck_xmiss
		endoptions
	}
	if main.rb_spss {
		require main.fi_spss
		require main.fi_out
		if !main.ck_replace {
			repfile main.fi_out
		}
		put "parqit save "
		put /smartquote main.fi_out
		put " using "
		put /smartquote main.fi_spss
		beginoptions
			if main.ck_replace | main.fi_out.repfile {
				put "replace "
			}
			optionarg /hidedefault opt.cb_comp
			optionarg opt.ed_level
			optionarg /hidedefault main.cb_spenc
			optionarg main.ed_obj
		endoptions
	}
END
