/*
  parqit describe - Describe and explore a view or a Parquet file

*!  VERSION 0.8.3  31oct2026

  User > parqit > Describe and explore data...
  Launch directly with:  db parqit_explore      (menu installed by: parqit menu)

  One list box of operations (Stata's interface guideline for more than
  about twelve choices), each an engine-side query that leaves the data in
  memory unchanged: describe, ds, lookfor, format, codebook, list,
  count, misstable [patterns], levelsof, unique, duplicates report/list.
  Summary statistics live in the companion dialog:  db parqit_stats
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 355
INCLUDE header
HELP hlp1, view("help parqit##explore")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call main.lb_op.forceselchange
	call program main_context
END

DIALOG main, label("parqit describe - Describe and explore a view or a Parquet file") ///
	tabtitle("Main")
BEGIN
  TEXT tx_op			_lft	_top	250	.,		///
	label("Operation:")
  LISTBOX lb_op			_lft	_ss	250	250,		///
	contents(op_words)						///
	values(op_vals)							///
	onselchangelist(op_change)					///
	label("Operation")

  TEXT tx_view			275	_top	315	.,		///
	label("View to explore:")
  COMBOBOX cb_view		275	_ss	315	.,		///
	dropdownlist nomemory contents(view_list)			///
	default("(select a view)")					///
	onselchange(program main_target)				///
	label("View to explore")

  TEXT tx_file			275	_ls	315	.,		///
	label("Parquet file, glob, or Hive directory:")
  FILE fi_file			275	_ss	315	.,		///
	error("Filename")						///
	defext(parquet)							///
	filter("Parquet (*.parquet)|*.parquet|All files (*.*)|*.*")	///
	label("Browse...")

  TEXT tx_vars			275	_ls	230	.,		///
	label("Variables (leave empty for all):")
  BUTTON bu_pop			510	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate combobox with the variable names of the selected view") ///
	label("Populate")
  COMBOBOX cb_vars		275	_ss	315	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	label("Variables")

  TEXT tx_note			275	_ls	315	.,		///
	label("Engine-side query; the data in memory are unchanged.")
  TEXT tx_context _lft 315 470 ., label("Selected view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_refresh)
END

DIALOG opt, tabtitle("Options")
BEGIN
  TEXT tx_if			_lft	_top	_iwd	.,		///
	label("If (expression):")
  EXP ex_if			_lft	_ss	_iwd	.,		///
	label("Create...")

  TEXT tx_limit			_lft	_ls	60	.,		///
	label("Limit:") right
  EDIT ed_limit			85	@	80	.,		///
	numonly								///
	option(limit)							///
	label("Limit")

  TEXT tx_from			_lft	_ls	60	.,		///
	label("From:") right
  EDIT ed_from			85	@	80	.,		///
	numonly								///
	label("From")
  TEXT tx_to			170	@	40	.,		///
	label("to:") right
  EDIT ed_to			215	@	80	.,		///
	numonly								///
	label("to")

  CHECKBOX ck_dmiss		_lft	_ls	_iwd	.,		///
	option(nomissing)						///
	label("Exclude missing values (nomissing)")
  TEXT tx_by			_lft	_ls	_iwd	.,		///
	label("Groups, option by() (unique; optional):")
  COMBOBOX cb_by		_lft	_ss	_iwd	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	option(by)							///
	label("Groups")
  CHECKBOX ck_dlab		_lft	_ls	260	.,		///
	option(labels)							///
	label("Value labels (labels)")
  CHECKBOX ck_dnotes		300	@	280	.,		///
	option(notes)							///
	label("Notes (notes)")

END

LIST view_list
BEGIN
	(select a view)
END

LIST vv_list
BEGIN
END

LIST op_words
BEGIN
	Describe the selected view
	Describe a Parquet file (footer only)
	List variable names (ds)
	Search names and labels (lookfor)
	Display formats (format)
	Codebook
	List observations (list)
	Count observations (count)
	Missing values by variable (misstable)
	Missing patterns (misstable patterns)
	Levels of one variable (levelsof)
	Unique values, jointly and per variable (unique)
	Report duplicates (duplicates report)
	List duplicates (duplicates list)
END

LIST op_vals
BEGIN
	descview
	descfile
	ds
	lookfor
	formats
	codebook
	list
	count
	misstable
	misspatterns
	levelsof
	unique
	dupreport
	duplist
END

LIST op_change
BEGIN
	script op_descview
	script op_descfile
	script op_descview
	script op_lookfor
	script op_format
	script op_vars
	script op_list
	script op_count
	script op_vars
	script op_patterns
	script op_levelsof
	script op_unique
	script op_keys
	script op_keys
END

SCRIPT all_off
BEGIN
	main.cb_view.withvalue main.tx_context.setlabel "Selected view: @"
	main.tx_view.enable
	main.cb_view.enable
	main.tx_file.disable
	main.fi_file.disable
	main.tx_vars.disable
	main.bu_pop.disable
	main.cb_vars.disable
	opt.tx_if.disable
	opt.ex_if.disable
	opt.tx_limit.disable
	opt.ed_limit.disable
	opt.tx_from.disable
	opt.ed_from.disable
	opt.tx_to.disable
	opt.ed_to.disable
	opt.ck_dmiss.disable
	opt.tx_by.disable
	opt.cb_by.disable
	opt.ck_dlab.disable
	opt.ck_dnotes.disable
	main.tx_vars.setlabel "Variables (leave empty for all):"
	main.tx_file.setlabel "Parquet file, glob, or Hive directory:"
END

SCRIPT vars_on
BEGIN
	main.tx_vars.enable
	main.bu_pop.enable
	main.cb_vars.enable
END

SCRIPT op_descview
BEGIN
	script all_off
END

SCRIPT op_descfile
BEGIN
	script all_off
	main.tx_view.disable
	main.cb_view.disable
	main.tx_context.setlabel "Source: Parquet file named above"
	main.tx_file.enable
	main.fi_file.enable
	opt.ck_dlab.enable
	opt.ck_dnotes.enable
END

SCRIPT op_lookfor
BEGIN
	script all_off
	script vars_on
	main.tx_vars.setlabel "Words to search for in variable names and labels:"
END

SCRIPT op_format
BEGIN
	script all_off
	script vars_on
END

SCRIPT op_vars
BEGIN
	script all_off
	script vars_on
	opt.tx_if.enable
	opt.ex_if.enable
END

SCRIPT op_patterns
BEGIN
	script all_off
	script vars_on
	main.tx_vars.setlabel "Variables (maximum 14; empty selects all):"
	opt.tx_if.enable
	opt.ex_if.enable
END

SCRIPT op_list
BEGIN
	script all_off
	script vars_on
	opt.tx_if.enable
	opt.ex_if.enable
	opt.tx_from.enable
	opt.ed_from.enable
	opt.tx_to.enable
	opt.ed_to.enable
END

SCRIPT op_count
BEGIN
	script all_off
	opt.tx_if.enable
	opt.ex_if.enable
END

SCRIPT op_levelsof
BEGIN
	script all_off
	script vars_on
	main.tx_vars.setlabel "Variable:"
	opt.tx_limit.enable
	opt.ed_limit.enable
	opt.tx_if.enable
	opt.ex_if.enable
END

SCRIPT op_unique
BEGIN
	script all_off
	script vars_on
	opt.ck_dmiss.enable
	opt.tx_by.enable
	opt.cb_by.enable
	opt.tx_if.enable
	opt.ex_if.enable
END

SCRIPT op_keys
BEGIN
	script all_off
	script vars_on
	main.tx_vars.setlabel "Key variables (leave empty for all):"
	opt.tx_limit.enable
	opt.ed_limit.enable
	opt.tx_if.enable
	opt.ex_if.enable
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM command
BEGIN
	if !main.lb_op.equals("descfile") {
		if main.cb_view.iseq("(select a view)") | !main.cb_view {
			stopbox stop "Select an open view on Main. Click Refresh to update the list."
		}
	}
	if main.lb_op.equals("descview") {
		put "parqit view " main.cb_view ": describe"
	}
	if main.lb_op.equals("descfile") {
		require main.fi_file
		put "parqit describe "
		put /smartquote main.fi_file
		beginoptions
			option opt.ck_dlab
			option opt.ck_dnotes
		endoptions
	}
	if main.lb_op.equals("ds") {
		put "parqit view " main.cb_view ": ds"
	}
	if main.lb_op.equals("lookfor") {
		require main.cb_vars
		put "parqit view " main.cb_view ": lookfor " main.cb_vars
	}
	if main.lb_op.equals("formats") {
		put "parqit view " main.cb_view ": format"
		if main.cb_vars {
			put " " main.cb_vars
		}
	}
	if main.lb_op.equals("codebook") {
		put "parqit view " main.cb_view ": codebook"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
	}
	if main.lb_op.equals("list") {
		put "parqit view " main.cb_view ": list"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
		if opt.ed_from | opt.ed_to {
			require opt.ed_from
			require opt.ed_to
			put " in " opt.ed_from "/" opt.ed_to
		}
	}
	if main.lb_op.equals("count") {
		put "parqit view " main.cb_view ": count"
		if opt.ex_if {
			put " if " opt.ex_if
		}
	}
	if main.lb_op.equals("misstable") {
		put "parqit view " main.cb_view ": misstable"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
	}
	if main.lb_op.equals("misspatterns") {
		put "parqit view " main.cb_view ": misstable patterns"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
	}
	if main.lb_op.equals("levelsof") {
		require main.cb_vars
		if main.cb_vars.isWordCountGT(1) {
			stopbox stop "Enter one variable for levelsof."
		}
		put "parqit view " main.cb_view ": levelsof " main.cb_vars
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg opt.ed_limit
		endoptions
	}
	if main.lb_op.equals("unique") {
		put "parqit view " main.cb_view ": unique"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg opt.cb_by
			option opt.ck_dmiss
		endoptions
	}
	if main.lb_op.equals("dupreport") {
		put "parqit view " main.cb_view ": duplicates report"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg opt.ed_limit
		endoptions
	}
	if main.lb_op.equals("duplist") {
		put "parqit view " main.cb_view ": duplicates list"
		if main.cb_vars {
			put " " main.cb_vars
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg opt.ed_limit
		endoptions
	}
END
