/*
  parqit keep - Keep or drop observations, or draw a random sample

*!  VERSION 0.8.2  28oct2026

  User > parqit > Keep or drop observations, or draw a sample...
  Launch directly with:  db parqit_filter      (menu installed by: parqit menu)

  Builds parqit keep if / drop if (with an optional by/bysort prefix) /
  keep in / drop in / sample. For sample, the
  if expression is the sampling frame, and strata, whole clusters and an
  indicator follow sample2. The Create... button
  opens Stata's expression builder (date functions td(), tm(), year(), ...
  included); Variables lists the names of the selected view (parqit ds).
  These verbs are lazy: they change the view's plan, not the data in memory.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 365
INCLUDE header
HELP hlp1, view("help parqit##verbs")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit keep - Keep or drop observations, or draw a random sample") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  RADIO rb_keepif		_lft	45	_lw80	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Keep observations satisfying a condition (keep if)")
  BUTTON bu_ds			_rj80	@	80	.,		///
	onpush(program main_ds)						///
	tooltip("List the variable names of the selected view (parqit ds)") ///
	label("Variables")
  RADIO rb_dropif		_lft	_ss	_iwd	.,		///
	onclickon(program main_mode)					///
	label("Drop observations satisfying a condition (drop if)")
  TEXT tx_if			_ilft	_ss	_ibwd	.,		///
	label("If (expression):")
  EXP ex_if			@	_ss	@	.,		///
	error("If (expression)")					///
	label("Create...")
  TEXT tx_bys			@	_ls	@	.,		///
	label("by/bysort prefix: group variables [(sort variables)] (optional):")
  EDIT ed_bys			@	_ss	300	.,		///
	label("bysort prefix")
  CHECKBOX ck_nosort		330	@	260	.,		///
	label("Already sorted (by, not bysort)")

  RADIO rb_keepin		_lft	_ls	_iwd	.,		///
	onclickon(program main_mode)					///
	label("Keep a range of observations of the pipeline result (keep in)")
  TEXT tx_from			_ilft	_ss	60	.,		///
	label("From:") right
  EDIT ed_from			85	@	80	.,		///
	default(1)							///
	label("From")
  TEXT tx_to			170	@	40	.,		///
	label("to:") right
  EDIT ed_to			215	@	80	.,		///
	label("to")
  TEXT tx_fl			_ilft	_ss	_ibwd	.,		///
	label("Bounds may be numbers, f (first), l (last), or negative counts from the end (-1 is the last observation).")
  RADIO rb_dropin		_lft	_ss	_iwd	.,		///
	onclickon(program main_mode)					///
	label("Drop a range of observations of the pipeline result (drop in)")

  RADIO rb_sample		_lft	_ls	_iwd	.,		///
	last								///
	onclickon(program main_mode)					///
	label("Draw a random sample of the observations (sample)")
  TEXT tx_note			_lft	_ls	_iwd	.,		///
	label("These verbs change the view's plan only; materialise the result with parqit collect or parqit save.")
  TEXT tx_context _lft 325 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_refresh)
END

DIALOG opt, tabtitle("Sampling")
BEGIN
  TEXT tx_amount		_ilft	_top	140	.,		///
	label("Amount:") right
  EDIT ed_amount		165	@	80	.,		///
	error("Amount")							///
	label("Amount")
  CHECKBOX ck_count		255	@	330	.,		///
	option(count)							///
	label("Amount is a number of observations, not a percentage (count)")
  TEXT tx_seed			_ilft	_ms	140	.,		///
	label("Random-number seed:") right
  EDIT ed_seed			165	@	80	.,		///
	numonly								///
	option(seed)							///
	label("Random-number seed")
  TEXT tx_by			_ilft	_ms	140	.,		///
	label("Strata (by):") right
  EDIT ed_by			165	@	420	.,		///
	option(by)							///
	label("Strata")
  TEXT tx_cluster		_ilft	_ms	140	.,		///
	label("Whole clusters of:") right
  EDIT ed_cluster		165	@	160	.,		///
	option(cluster)							///
	label("Cluster variable")
  COMBOBOX cb_rule		335	@	250	.,		///
	dropdownlist							///
	contents(rule_words)						///
	values(rule_vals)						///
	label("Clusters that if splits")
  TEXT tx_gen			_ilft	_ms	140	.,		///
	label("Flag, do not drop:") right
  EDIT ed_gen			165	@	160	.,		///
	max(32)								///
	option(generate)						///
	label("Indicator variable")

END

LIST rule_words
BEGIN
	A cluster split by if is an error
	Any selected row places it (any)
	Only all rows place it (all)
END

LIST rule_vals
BEGIN
	strict
	any
	all
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

PROGRAM main_mode
BEGIN
	call main.tx_if.disable
	call main.ex_if.disable
	call main.tx_bys.disable
	call main.ed_bys.disable
	call main.ck_nosort.disable
	call main.tx_from.disable
	call main.ed_from.disable
	call main.tx_to.disable
	call main.ed_to.disable
	call main.tx_fl.disable
	call opt.tx_amount.disable
	call opt.ed_amount.disable
	call opt.ck_count.disable
	call opt.tx_seed.disable
	call opt.ed_seed.disable
	call opt.tx_by.disable
	call opt.ed_by.disable
	call opt.tx_cluster.disable
	call opt.ed_cluster.disable
	call opt.cb_rule.disable
	call opt.tx_gen.disable
	call opt.ed_gen.disable
	if main.rb_keepif | main.rb_dropif {
		call main.tx_if.enable
		call main.ex_if.enable
		call main.tx_bys.enable
		call main.ed_bys.enable
		call main.ck_nosort.enable
	}
	if main.rb_keepin | main.rb_dropin {
		call main.tx_from.enable
		call main.ed_from.enable
		call main.tx_to.enable
		call main.ed_to.enable
		call main.tx_fl.enable
	}
	if main.rb_sample {
		call main.tx_if.enable
		call main.ex_if.enable
		call opt.tx_amount.enable
		call opt.ed_amount.enable
		call opt.ck_count.enable
		call opt.tx_seed.enable
		call opt.ed_seed.enable
		call opt.tx_by.enable
		call opt.ed_by.enable
		call opt.tx_cluster.enable
		call opt.ed_cluster.enable
		call opt.cb_rule.enable
		call opt.tx_gen.enable
		call opt.ed_gen.enable
	}
END

PROGRAM main_ds
BEGIN
	call program main_require
	put "parqit view " main.cb_view ": ds"
	stata
END

PROGRAM command
BEGIN
	call program main_require
	if main.rb_keepif {
		require main.ex_if
		if main.ed_bys {
			if main.ck_nosort {
				put "parqit view " main.cb_view ": by " main.ed_bys ": keep if " main.ex_if
			}
			else {
				put "parqit view " main.cb_view ": bysort " main.ed_bys ": keep if " main.ex_if
			}
		}
		else {
			put "parqit view " main.cb_view ": keep if " main.ex_if
		}
	}
	if main.rb_dropif {
		require main.ex_if
		if main.ed_bys {
			if main.ck_nosort {
				put "parqit view " main.cb_view ": by " main.ed_bys ": drop if " main.ex_if
			}
			else {
				put "parqit view " main.cb_view ": bysort " main.ed_bys ": drop if " main.ex_if
			}
		}
		else {
			put "parqit view " main.cb_view ": drop if " main.ex_if
		}
	}
	if main.rb_keepin {
		require main.ed_from
		require main.ed_to
		put "parqit view " main.cb_view ": keep in " main.ed_from "/" main.ed_to
	}
	if main.rb_dropin {
		require main.ed_from
		require main.ed_to
		put "parqit view " main.cb_view ": drop in " main.ed_from "/" main.ed_to
	}
	if main.rb_sample {
		require opt.ed_amount
		put "parqit view " main.cb_view ": sample " opt.ed_amount
		if main.ex_if {
			put " if " main.ex_if
		}
		beginoptions
			option opt.ck_count
			optionarg opt.ed_seed
			optionarg opt.ed_by
			optionarg opt.ed_cluster
			if opt.ed_cluster & !opt.cb_rule.equals("strict") {
				put " " opt.cb_rule
			}
			optionarg opt.ed_gen
		endoptions
	}
END
