/*
  parqit keep - Keep, drop, order, sort, or rename variables; drop duplicates

*!  VERSION 0.8.3  31oct2026

  User > parqit > Keep, drop, order, sort, or rename variables...
  Launch directly with:  db parqit_vars      (menu installed by: parqit menu)

  Builds parqit keep / drop / order / sort / gsort / format / rename / duplicates drop.
  Populate fills the variable pickers from the selected view (parqit ds).
  These verbs are lazy: they change the view's plan, not the data in memory.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 395
INCLUDE header
HELP hlp1, view("help parqit##verbs")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit keep - Keep, drop, order, sort, or rename variables; drop duplicate observations") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  RADIO rb_keep			_lft	45	_lw80	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Keep only these variables (keep)")
  BUTTON bu_pop			_rj80	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate the comboboxes with the variable names of the selected view") ///
	label("Populate")
  RADIO rb_drop			_lft	_ss	_iwd	.,		///
	onclickon(program main_mode)					///
	label("Drop these variables (drop)")
  RADIO rb_order		@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Move these variables to the front (order)")
  RADIO rb_sort			@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Sort by these variables, ascending (sort)")
  RADIO rb_gsort		@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Sort with a + or - prefix per variable, for example -wage id (gsort)")
  RADIO rb_format @ _ss @ ., ///
    onclickon(program main_mode) ///
    label("Set display formats, including dates (format)")
  TEXT tx_vars			_ilft	_ms	_ibwd	.,		///
	label("Variables:")
  COMBOBOX cb_vars		@	_ss	@	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("Variables")						///
	label("Variables")

  TEXT tx_fmt _ilft _ms _ibwd ., label("Display format (for example %td, %tc, %tm or %12.2f):")
  EDIT ed_fmt @ _ss @ ., error("Display format") label("Display format")

  RADIO rb_rename		_lft	_ls	_iwd	.,		///
	onclickon(program main_mode)					///
	label("Rename variables (rename)")
  TEXT tx_old			_ilft	_ss	270	.,		///
	label("Existing variable names:")
  TEXT tx_new			_lft2	@	_cwd1	.,		///
	label("New variable names:")
  COMBOBOX cb_old		_ilft	_ss	270	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("Existing variable names")				///
	label("Existing variable names")
  EDIT ed_new			_lft2	@	_cwd1	.,		///
	error("New variable names")					///
	label("New variable names")

  RADIO rb_dupdrop		_lft	_ls	_iwd	.,		///
	last								///
	onclickon(program main_mode)					///
	label("Drop duplicate observations (duplicates drop)")
  TEXT tx_context _lft 355 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_populate)
END

DIALOG opt, tabtitle("Duplicates")
BEGIN
  TEXT tx_keys			_ilft	_top	_ibwd	.,		///
	label("Key variables (leave empty to compare entire observations):")
  COMBOBOX cb_keys		@	_ss	@	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	label("Key variables")
  TEXT tx_if			@	_ls	@	.,		///
	label("If (expression) (optional):")
  EXP ex_if			@	_ss	@	.,		///
	label("Create...")
  CHECKBOX ck_force		@	_ms	@	.,		///
	option(force)							///
	label("Force the drop, even though information may be lost (required with key variables; sort the view first)")
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

LIST vv_list
BEGIN
END

PROGRAM main_mode
BEGIN
	call main.tx_vars.disable
	call main.cb_vars.disable
	call main.tx_fmt.disable
	call main.ed_fmt.disable
	call main.tx_old.disable
	call main.cb_old.disable
	call main.tx_new.disable
	call main.ed_new.disable
	call opt.tx_keys.disable
	call opt.cb_keys.disable
	call opt.tx_if.disable
	call opt.ex_if.disable
	call opt.ck_force.disable
	if main.rb_keep | main.rb_drop | main.rb_order | main.rb_sort | main.rb_gsort | main.rb_format {
		call main.tx_vars.enable
		call main.cb_vars.enable
	}
	if main.rb_format {
		call main.tx_fmt.enable
		call main.ed_fmt.enable
	}
	if main.rb_rename {
		call main.tx_old.enable
		call main.cb_old.enable
		call main.tx_new.enable
		call main.ed_new.enable
	}
	if main.rb_dupdrop {
		call opt.tx_keys.enable
		call opt.cb_keys.enable
		call opt.tx_if.enable
		call opt.ex_if.enable
		call opt.ck_force.enable
	}
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM command
BEGIN
	call program main_require
	if main.rb_keep {
		require main.cb_vars
		put "parqit view " main.cb_view ": keep " main.cb_vars
	}
	if main.rb_drop {
		require main.cb_vars
		put "parqit view " main.cb_view ": drop " main.cb_vars
	}
	if main.rb_order {
		require main.cb_vars
		put "parqit view " main.cb_view ": order " main.cb_vars
	}
	if main.rb_sort {
		require main.cb_vars
		put "parqit view " main.cb_view ": sort " main.cb_vars
	}
	if main.rb_gsort {
		require main.cb_vars
		put "parqit view " main.cb_view ": gsort " main.cb_vars
	}
	if main.rb_rename {
		require main.cb_old
		require main.ed_new
		put "parqit view " main.cb_view ": rename (" main.cb_old ") (" main.ed_new ")"
	}
	if main.rb_format {
		require main.cb_vars
		require main.ed_fmt
		put "parqit view " main.cb_view ": format " main.cb_vars " " main.ed_fmt
	}
	if main.rb_dupdrop {
		put "parqit view " main.cb_view ": duplicates drop"
		if opt.cb_keys {
			put " " opt.cb_keys
		}
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			option opt.ck_force
		endoptions
	}
END
