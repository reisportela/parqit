/*
  parqit merge - Combine the view with a file or another view, or join the
  data in memory with a file

*!  VERSION 0.8.2  28oct2026

  User > parqit > Combine datasets (merge, append, joinby)...
  Launch directly with:  db parqit_combine      (menu installed by: parqit menu)

  Main tab: the lazy two-table verbs (merge, append, joinby) whose using side
  is a Parquet file, glob, Hive directory, delimited text, .dta, Excel, SPSS
  .sav/.zsav, R .rds/.rda/.RData (the last five bridged) or another open view
  typed as view:name; and the native in-memory routes (mergein, appendin).
  Options tab: native Stata's merge and append options, each enabled for the
  commands that take it (nonotes for every merge and append, nolabel for
  mergein/appendin, the rest for mergein), appendin's force, and the code page
  of a legacy .dta/Excel/SPSS/R using source. Populate fills the key pickers from the
  selected master view (lazy verbs) or from the using file (memory verbs), and the
  using-variable picker from its own source. The Using source tab can select
  another open view for a lazy combination; native memory routes use a file.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 395
INCLUDE header
HELP hlp1, view("help parqit##verbs")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
	create STRING pq_using_name
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit merge - Combine the view with a file or another view, or join the data in memory with a file") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 80 ., label("Master view:")
  COMBOBOX cb_view 95 @ 495 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("Master view")
  GROUPBOX gb_type		_lft	45	_iwd	_ht10,		///
	label("Type of combination")
  RADIO rb_merge		_ilft	_ss	_ibwd	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Merge the view with a using source on key variables (merge 1:1, m:1, 1:m; lazy)")
  RADIO rb_append		@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Append using sources to the view (append; lazy)")
  RADIO rb_joinby		@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Form all pairwise combinations within groups of key variables (joinby; lazy)")
  RADIO rb_mergein		@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Merge the data in memory with a file (mergein; native merge, the data stay in memory)")
  RADIO rb_appendin		@	_ss	@	.,		///
	last								///
	onclickon(program main_mode)					///
	label("Append a file to the data in memory (appendin; native append)")

  TEXT tx_using			_lft	185	_lw80	.,		///
	label("Using source: filename, glob, Hive directory, or view:name (lazy types):")
  BUTTON bu_pop			_rj80	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate keys from the selected master view (or the using file for native routes) and using variables from their own source") ///
	label("Populate")
  FILE fi_using			_lft	_ss	_iwd	.,		///
	onchange(program main_refresh)					///
	error("Using source")						///
	defext(parquet)							///
	filter("Data files|*.parquet;*.csv;*.tsv;*.txt;*.tab;*.dta;*.xlsx;*.xls;*.sav;*.zsav;*.rds;*.rda;*.RData|Parquet|*.parquet|Text|*.csv;*.tsv;*.txt;*.tab|Stata|*.dta|Excel|*.xlsx;*.xls|SPSS|*.sav;*.zsav|R|*.rds;*.rda;*.RData|All files|*.*") ///
	label("Browse...")

  TEXT tx_kind			_lft	_ls	_vnwd	.,		///
	label("Merge type:")
  TEXT tx_keys			140	@	450	.,		///
	label("Key variables (match variables):")
  COMBOBOX cb_kind		_lft	_ss	_vnwd	.,		///
	dropdownlist							///
	contents(kind_list)						///
	default("m:1")							///
	label("Merge type")
  COMBOBOX cb_keys		140	@	450	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("Key variables")						///
	label("Key variables")

  TEXT tx_keepus		_lft	_ls	_iwd	.,		///
	label("Variables to keep from the using source (all by default): keepusing() for merge/mergein, keep() for append/appendin:")
  COMBOBOX cb_keepus		@	_ss	@	.,		///
	append								///
	dropdown							///
	contents(uv_list)						///
	label("Variables to keep from the using source")

  TEXT tx_context _lft 355 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_populate)
END

DIALOG results, tabtitle("Results")
BEGIN
  GROUPBOX gb_keep		_lft	_top	_iwd	_ht2,		///
	label("Results to keep (merge; leave all unchecked to keep all)")
  CHECKBOX ck_master		_ilft	_ss	180	.,		///
	label("Record appeared in master only")
  CHECKBOX ck_using		210	@	180	.,		///
	label("Record appeared in using only")
  CHECKBOX ck_match		400	@	170	.,		///
	label("Record appeared in both")

  TEXT tx_gen			_lft	_xls	_iwd	.,		///
	label("Name of new variable to mark merge results (default _merge):")
  EDIT ed_gen			@	_ss	_vnwd	.,		///
	max(32)								///
	option(generate)						///
	label("Name of new variable to mark results")
  CHECKBOX ck_nogen		140	@	450	.,		///
	option(nogenerate)						///
	onclickon(results.ed_gen.disable)					///
	onclickoff(results.ed_gen.enable)					///
	label("Do not generate a variable marking merge results")
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

DIALOG source, tabtitle("Using source")
BEGIN
  CHECKBOX ck_usingview _lft _top _iwd ., ///
	label("Use another open view as the using source (lazy merge, append or joinby)") ///
	onclickon(program main_mode) onclickoff(program main_mode)
  TEXT tx_usingview _lft _ls _iwd ., label("Using view:")
  COMBOBOX cb_usingview _lft _ss _iwd ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_using) label("Using view")
  TEXT tx_more _lft _ls _iwd ., ///
	label("Additional using sources for append (filenames, globs, or view:name, separated by spaces):")
  EDIT ed_more @ _ss @ ., ///
	tooltip("Use Stata compound quotes around each additional path containing spaces or commas") ///
	label("Additional using sources")
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_using
BEGIN
	call program main_refresh
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open master view. Click Refresh to update the list."
	}
END

PROGRAM using_output
BEGIN
	if source.ck_usingview {
		if !source.cb_usingview | source.cb_usingview.iseq("(select a view)") {
			stopbox stop "Select an open using view on Using source."
		}
		put "view:" source.cb_usingview
	}
	else {
		require main.fi_using
		put /smartquote main.fi_using
	}
END

DIALOG opt, tabtitle("Options")
BEGIN
  GROUPBOX gb_native		_lft	_top	_iwd	_ht12,		///
	label("Merge and append options, as in native Stata (enabled where the command takes them)")
  CHECKBOX ck_update		_ilft	_ss	_ibwd	.,		///
	option(update)							///
	onclickon(opt.ck_mreplace.enable)				///
	onclickoff(opt.ck_mreplace.disable)				///
	label("Update missing values with values from the file (update)")
  CHECKBOX ck_mreplace		@	_ss	@	.,		///
	option(replace)							///
	label("Replace nonmissing values with values from the file (replace; requires update)")
  CHECKBOX ck_nolabel		@	_ss	@	.,		///
	option(nolabel)							///
	label("Do not copy value label definitions from the file (nolabel)")
  CHECKBOX ck_nonotes		@	_ss	@	.,		///
	option(nonotes)							///
	label("Do not copy notes from the file (nonotes)")
  CHECKBOX ck_mforce		@	_ss	@	.,		///
	option(force)							///
	label("Allow string/numeric variable type mismatch without error (force)")
  CHECKBOX ck_noreport		@	_ss	@	.,		///
	option(noreport)						///
	label("Do not display the result summary table (noreport)")
  TEXT tx_assert		_lft	_xls	_iwd	.,		///
	label("Require merge results, assert() (mergein; for example: match master):")
  EDIT ed_assert		@	_ss	@	.,		///
	option(assert)							///
	label("Require merge results")

  CHECKBOX ck_aforce		_lft	_ls	_iwd	.,		///
	option(force)							///
	label("Append string variables to numeric or numeric to string without error (appendin; force)")

  TEXT tx_enc			_lft	_ls	_iwd	.,		///
	label("Encoding of text that is not UTF-8 in the using file (delimited text, .dta, Excel, SPSS or R):")
  COMBOBOX cb_enc		@	_ss	_vnwd	.,		///
	dropdown							///
	contents(enc_list)						///
	default("default")						///
	option(encoding)						///
	tooltip("default: delimited text as UTF-8 or else in the session code page, .dta text in the session code page (windows-1252 unless parqit set encoding), SPSS and R files as they declare; pick or type any encoding parqit reads") ///
	label("Encoding")
  TEXT tx_int64 _lft _ls _iwd ., ///
	label("Large integers read by mergein/appendin (default = inherit the session):")
  COMBOBOX cb_int64 @ _ss _vnwd ., dropdownlist contents(i64_list) ///
	default("default") option(int64) label("Integers beyond 2^53") ///
	tooltip("string preserves exact digits; merge keys must have compatible types on both sides")
END

LIST vv_list
BEGIN
END

LIST uv_list
BEGIN
END

LIST enc_list
BEGIN
	default
	utf-8
	windows-1252
	latin1
	latin9
	macroman
	windows-1250
	windows-1251
	windows-1253
	windows-1254
	windows-1255
	windows-1256
	windows-1257
	windows-1258
	windows-874
	koi8-r
	koi8-u
	ibm866
	iso-8859-2
	iso-8859-5
	iso-8859-7
	shift_jis
	euc-jp
	gbk
	gb18030
	big5
	euc-kr
	utf-16le
	utf-16be
END

LIST kind_list
BEGIN
	"1:1"
	"m:1"
	"1:m"
	"m:m"
END

LIST i64_list
BEGIN
	default
	refuse
	round
	string
END

PROGRAM main_mode
BEGIN
	call source.tx_more.disable
	call source.ed_more.disable
	call main.tx_kind.disable
	call main.cb_kind.disable
	call main.tx_keys.disable
	call main.cb_keys.disable
	call main.tx_keepus.disable
	call main.cb_keepus.disable
	call results.gb_keep.disable
	call results.ck_master.disable
	call results.ck_using.disable
	call results.ck_match.disable
	call results.tx_gen.disable
	call results.ed_gen.disable
	call results.ck_nogen.disable
	call opt.gb_native.disable
	call opt.ck_update.disable
	call opt.ck_mreplace.disable
	call opt.ck_nolabel.disable
	call opt.ck_nonotes.disable
	call opt.ck_mforce.disable
	call opt.ck_noreport.disable
	call opt.tx_assert.disable
	call opt.ed_assert.disable
	call opt.ck_aforce.disable
	call opt.tx_enc.disable
	call opt.cb_enc.disable
	call opt.tx_int64.disable
	call opt.cb_int64.disable
	if main.rb_merge | main.rb_mergein {
		call main.tx_kind.enable
		call main.cb_kind.enable
		call main.tx_keys.enable
		call main.cb_keys.enable
		call main.tx_keepus.enable
		call main.cb_keepus.enable
		call results.gb_keep.enable
		call results.ck_master.enable
		call results.ck_using.enable
		call results.ck_match.enable
		call results.tx_gen.enable
		call results.ck_nogen.enable
		call results.tx_gen.setlabel "Name of new variable to mark merge results (default _merge):"
		if !results.ck_nogen {
			call results.ed_gen.enable
		}
	}
	if main.rb_append {
		call source.tx_more.enable
		call source.ed_more.enable
		call main.tx_keepus.enable
		call main.cb_keepus.enable
		call results.tx_gen.enable
		call results.ed_gen.enable
		call results.tx_gen.setlabel "Name of new variable to mark the source of each observation (optional):"
	}
	if main.rb_joinby {
		call main.tx_keys.enable
		call main.cb_keys.enable
	}
	if main.rb_merge | main.rb_append | main.rb_joinby {
		call main.tx_using.setlabel "Using source: filename, glob, Hive directory, or view:name:"
	}
	if main.rb_merge | main.rb_append | main.rb_joinby | main.rb_mergein | main.rb_appendin {
		call opt.tx_enc.enable
		call opt.cb_enc.enable
	}
	if main.rb_merge | main.rb_append | main.rb_mergein | main.rb_appendin {
		call opt.gb_native.enable
		call opt.ck_nonotes.enable
	}
	if main.rb_mergein {
		call main.tx_using.setlabel "Using file (Parquet, delimited text, .dta, Excel, SPSS or R):"
		call opt.tx_int64.enable
		call opt.cb_int64.enable
		call opt.gb_native.enable
		call opt.ck_update.enable
		call opt.ck_nolabel.enable
		call opt.ck_nonotes.enable
		call opt.ck_mforce.enable
		call opt.ck_noreport.enable
		call opt.tx_assert.enable
		call opt.ed_assert.enable
		if opt.ck_update {
			call opt.ck_mreplace.enable
		}
	}
	if main.rb_appendin {
		call main.tx_using.setlabel "Using file (Parquet, delimited text, .dta, Excel, SPSS or R):"
		call opt.tx_int64.enable
		call opt.cb_int64.enable
		call main.tx_keepus.enable
		call main.cb_keepus.enable
		call results.tx_gen.enable
		call results.ed_gen.enable
		call results.tx_gen.setlabel "Name of new variable to mark the source of each observation (optional):"
		call opt.ck_nolabel.enable
		call opt.ck_aforce.enable
	}
	if main.rb_mergein | main.rb_appendin {
		call main.tx_view.disable
		call main.cb_view.disable
		call source.ck_usingview.disable
		call source.tx_usingview.disable
		call source.cb_usingview.disable
		call main.fi_using.enable
	}
	else {
		call main.tx_view.enable
		call main.cb_view.enable
		call source.ck_usingview.enable
		if source.ck_usingview {
			call source.tx_usingview.enable
			call source.cb_usingview.enable
			call main.fi_using.disable
		}
		else {
			call source.tx_usingview.disable
			call source.cb_usingview.disable
			call main.fi_using.enable
		}
	}
	call program main_refresh
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM main_keep_output
BEGIN
	if results.ck_master | results.ck_using | results.ck_match {
		put "keep("
		if results.ck_master {
			put "master "
		}
		if results.ck_using {
			put "using "
		}
		if results.ck_match {
			put "match"
		}
		put ") "
	}
END

PROGRAM command
BEGIN
	if main.rb_merge | main.rb_append | main.rb_joinby {
		call program main_require
	}
	if main.rb_merge {
		require main.cb_keys
		if main.cb_kind.iseq("m:m") {
			stopbox stop "Lazy merge does not support m:m." ///
				"Use joinby for all pairwise combinations, or mergein m:m for native Stata's sequential behavior."
		}
		put "parqit view " main.cb_view ": merge " main.cb_kind " " main.cb_keys " using "
		put /program using_output
		beginoptions
			put /program main_keep_output
			if main.cb_keepus {
				put " keepusing(" main.cb_keepus ") "
			}
			option results.ck_nogen
			if !results.ck_nogen {
				optionarg results.ed_gen
			}
			option opt.ck_nonotes
			optionarg /hidedefault opt.cb_enc
		endoptions
	}
	if main.rb_append {
		put "parqit view " main.cb_view ": append using "
		put /program using_output
		if source.ed_more {
			put " " source.ed_more
		}
		beginoptions
			optionarg results.ed_gen
			if main.cb_keepus {
				put "keep(" main.cb_keepus ") "
			}
			option opt.ck_nonotes
			optionarg /hidedefault opt.cb_enc
		endoptions
	}
	if main.rb_joinby {
		require main.cb_keys
		put "parqit view " main.cb_view ": joinby " main.cb_keys " using "
		put /program using_output
		beginoptions
			optionarg /hidedefault opt.cb_enc
		endoptions
	}
	if main.rb_mergein {
		require main.cb_keys
		require main.fi_using
		put "parqit mergein " main.cb_kind " " main.cb_keys " using "
		put /smartquote main.fi_using
		beginoptions
			put /program main_keep_output
			if main.cb_keepus {
				put " keepusing(" main.cb_keepus ") "
			}
			option results.ck_nogen
			if !results.ck_nogen {
				optionarg results.ed_gen
			}
			optionarg opt.ed_assert
			option opt.ck_update
			if opt.ck_update {
				option opt.ck_mreplace
			}
			option opt.ck_nolabel
			option opt.ck_nonotes
			option opt.ck_mforce
			option opt.ck_noreport
			optionarg /hidedefault opt.cb_int64
			optionarg /hidedefault opt.cb_enc
		endoptions
	}
	if main.rb_appendin {
		require main.fi_using
		put "parqit appendin using "
		put /smartquote main.fi_using
		beginoptions
			if main.cb_keepus {
				put "keep(" main.cb_keepus ") "
			}
			optionarg results.ed_gen
			option opt.ck_nolabel
			option opt.ck_nonotes
			option opt.ck_aforce
			optionarg /hidedefault opt.cb_int64
			optionarg /hidedefault opt.cb_enc
		endoptions
	}
END
