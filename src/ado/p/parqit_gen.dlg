/*
  parqit generate - Create a new variable, or change the contents of a variable

*!  VERSION 0.8.1  28oct2026

  User > parqit > Create or change variables...
  Launch directly with:  db parqit_gen      (menu installed by: parqit menu)

  Builds parqit gen / egen / replace. Both Create... buttons open Stata's
  expression builder (dates via td(), tm(), year(), mdy(), ...). Untyped numeric
  gen uses double; egen infers its result type. Choose a type to request explicit
  storage. Lazy: the view's plan changes, not the data in memory. The fourth
  choice, parqit spssencode, works on the data in memory instead: the labelled
  numeric version of a string variable read from an SPSS file.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 345
INCLUDE header
HELP hlp1, view("help parqit##expressions")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit generate - Create a new variable, or change the contents of a variable") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  RADIO rb_gen			_lft	45	_iwd	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Create a new variable (generate)")
  RADIO rb_egen			@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Create a new variable by group (egen)")
  RADIO rb_repl			@	_ss	@	.,		///
	onclickon(program main_mode)					///
	label("Change contents of a variable (replace)")
  RADIO rb_spss			@	_ss	@	.,		///
	last								///
	onclickon(program main_mode)					///
	label("Labelled numeric version of an SPSS- or R-labelled string variable in memory (spssencode)")

  TEXT tx_type			_lft	_ls	_vnwd	.,		///
	label("Variable type:")
  TEXT tx_name			140	@	160	.,		///
	label("Variable name:")
  TEXT tx_fcn			310	@	120	.,		///
	label("egen function:")
  BUTTON bu_pop			_rj80	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate the by() combobox with the variable names of the selected view") ///
	label("Populate")
  COMBOBOX cb_type		_lft	_ss	_vnwd	.,		///
	dropdown							///
	contents(type_list)						///
	default("(default)")						///
	tooltip("String types apply to generate only; egen requires a numeric type") ///
	label("Variable type")
  EDIT ed_name			140	@	160	.,		///
	max(32)								///
	error("Variable name")						///
	label("Variable name")
  COMBOBOX cb_fcn		310	@	_vnwd	.,		///
	dropdownlist							///
	contents(fcn_list)						///
	default("mean")							///
	label("egen function")

  TEXT tx_exp			_lft	_ls	_iwd	.,		///
	label("Expression (dates as td(01jan2015), year(x), ...):")
  EXP ex_exp			@	_ss	@	.,		///
	error("Expression")						///
	label("Create...")

  TEXT tx_if			_lft	_ls	_iwd	.,		///
	label("If (expression) (optional):")
  EXP ex_if			@	_ss	@	.,		///
	label("Create...")

  TEXT tx_note			_lft	_ls	_iwd	.,		///
	label("Untyped numeric generate uses double; egen infers its result type. Select a type to request explicit storage.")
  TEXT tx_context _lft 305 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_populate)
END

DIALOG opt, tabtitle("Groups and labels")
BEGIN
  TEXT tx_by			_lft	_top	_iwd	.,		///
	label("Group variables for egen, option by() (optional):")
  COMBOBOX cb_by			@	_ss	@	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	option(by)							///
	label("Group variables")
  TEXT tx_eopt			_lft	_ls	_iwd	.,		///
	label("Other egen options, typed as in Stata, for example p(25) or punct(-) or missing:")
  EDIT ed_eopt			@	_ss	@	.,		///
	label("egen options")
  TEXT tx_bys			_lft	_ls	_iwd	.,		///
	label("by/bysort prefix: group variables [(sort variables)] (optional; gen, replace, egen):")
  EDIT ed_bys			@	_ss	300	.,		///
	label("bysort prefix")
  CHECKBOX ck_nosort		320	@	270	.,		///
	label("Already sorted (by, not bysort)")

  TEXT tx_src			_lft	_ls	280	.,		///
	label("SPSS- or R-labelled string variable in memory:")
  TEXT tx_lab			310	@	280	.,		///
	label("Value label name (optional; default: the new variable):")
  VARNAME vn_src		_lft	_ss	280	.,		///
	error("Labelled string variable")					///
	label("Labelled string variable")
  EDIT ed_lab			310	@	160	.,		///
	max(32)								///
	option(label)							///
	label("Value label name")
  CHECKBOX ck_seq		_lft	_ms	_iwd	.,		///
	option(sequential)						///
	label("Number the codes 1, 2, ... even when they are integers (sequential)")

END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

LIST vv_list
BEGIN
END

LIST type_list
BEGIN
	"(default)"
	byte
	int
	long
	float
	double
	str8
	strL
END

LIST fcn_list
BEGIN
	total
	mean
	sd
	min
	max
	count
	median
	pctile
	iqr
	kurt
	skew
	mad
	mdev
	std
	pc
	rank
	mode
	seq
	group
	tag
	anycount
	anymatch
	anyvalue
	concat
	cut
	diff
	ends
	rowtotal
	rowmean
	rowmin
	rowmax
	rowmiss
	rownonmiss
	rowsd
	rowfirst
	rowlast
	rowmedian
	rowpctile
END

PROGRAM main_mode
BEGIN
	call main.tx_view.enable
	call main.cb_view.enable
	if !main.rb_spss {
		call main.tx_exp.enable
		call main.ex_exp.enable
		call opt.tx_src.disable
		call opt.vn_src.disable
		call opt.tx_lab.disable
		call opt.ed_lab.disable
		call opt.ck_seq.disable
		call main.tx_note.setlabel "Untyped numeric generate uses double; egen infers its result type. Select a type to request explicit storage."
	}
	if main.rb_gen {
		call main.tx_type.enable
		call main.cb_type.enable
		call main.tx_fcn.disable
		call main.cb_fcn.disable
		call main.tx_if.enable
		call main.ex_if.enable
		call opt.tx_by.disable
		call opt.cb_by.disable
		call opt.tx_eopt.disable
		call opt.ed_eopt.disable
		call opt.tx_bys.enable
		call opt.ed_bys.enable
		call opt.ck_nosort.enable
		call main.bu_pop.disable
	}
	if main.rb_egen {
		call main.tx_type.enable
		call main.cb_type.enable
		call main.tx_fcn.enable
		call main.cb_fcn.enable
		call main.tx_if.enable
		call main.ex_if.enable
		call opt.tx_by.enable
		call opt.cb_by.enable
		call opt.tx_eopt.enable
		call opt.ed_eopt.enable
		call opt.tx_bys.enable
		call opt.ed_bys.enable
		call opt.ck_nosort.enable
		call main.bu_pop.enable
	}
	if main.rb_repl {
		call main.tx_type.disable
		call main.cb_type.disable
		call main.tx_fcn.disable
		call main.cb_fcn.disable
		call main.tx_if.enable
		call main.ex_if.enable
		call opt.tx_by.disable
		call opt.cb_by.disable
		call opt.tx_eopt.disable
		call opt.ed_eopt.disable
		call opt.tx_bys.enable
		call opt.ed_bys.enable
		call opt.ck_nosort.enable
		call main.bu_pop.disable
	}
	if main.rb_spss {
		call main.tx_view.disable
		call main.cb_view.disable
		call main.tx_type.disable
		call main.cb_type.disable
		call main.tx_fcn.disable
		call main.cb_fcn.disable
		call main.tx_exp.disable
		call main.ex_exp.disable
		call main.tx_if.disable
		call main.ex_if.disable
		call opt.tx_by.disable
		call opt.cb_by.disable
		call opt.tx_eopt.disable
		call opt.ed_eopt.disable
		call opt.tx_bys.disable
		call opt.ed_bys.disable
		call opt.ck_nosort.disable
		call main.bu_pop.disable
		call opt.tx_src.enable
		call opt.vn_src.enable
		call opt.tx_lab.enable
		call opt.ed_lab.enable
		call opt.ck_seq.enable
		call main.tx_note.setlabel "Uses the SPSS codes when they are distinct integers, otherwise 1, 2, ... in code order; user-missing codes become .a-.z."
	}
	call program main_refresh
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM command
BEGIN
	if !main.rb_spss {
		call program main_require
	}
	if main.rb_gen {
		if opt.ed_bys {
			if opt.ck_nosort {
				put "parqit view " main.cb_view ": by " opt.ed_bys ": gen "
			}
			else {
				put "parqit view " main.cb_view ": bysort " opt.ed_bys ": gen "
			}
		}
		else {
			put "parqit view " main.cb_view ": gen "
		}
		if !main.cb_type.isdefault() {
			put main.cb_type " "
		}
		require main.ed_name
		put main.ed_name " = "
		require main.ex_exp
		put main.ex_exp
		if main.ex_if {
			put " if " main.ex_if
		}
	}
	if main.rb_egen {
		if main.cb_type.startswith("str") {
			stopbox stop "egen functions produce numeric results." ///
				"Choose (default), byte, int, long, float, or double."
		}
		if opt.ed_bys {
			if opt.ck_nosort {
				put "parqit view " main.cb_view ": by " opt.ed_bys ": egen "
			}
			else {
				put "parqit view " main.cb_view ": bysort " opt.ed_bys ": egen "
			}
		}
		else {
			put "parqit view " main.cb_view ": egen "
		}
		if !main.cb_type.isdefault() {
			put main.cb_type " "
		}
		require main.ed_name
		put main.ed_name " = " main.cb_fcn "("
		if main.ex_exp {
			put main.ex_exp
		}
		put ")"
		if main.ex_if {
			put " if " main.ex_if
		}
		beginoptions
			optionarg opt.cb_by
			if opt.ed_eopt {
				put opt.ed_eopt
			}
		endoptions
	}
	if main.rb_repl {
		if opt.ed_bys {
			if opt.ck_nosort {
				put "parqit view " main.cb_view ": by " opt.ed_bys ": replace "
			}
			else {
				put "parqit view " main.cb_view ": bysort " opt.ed_bys ": replace "
			}
		}
		else {
			put "parqit view " main.cb_view ": replace "
		}
		require main.ed_name
		put main.ed_name " = "
		require main.ex_exp
		put main.ex_exp
		if main.ex_if {
			put " if " main.ex_if
		}
	}
	if main.rb_spss {
		require opt.vn_src
		require main.ed_name
		put "parqit spssencode " opt.vn_src
		beginoptions
			put "generate(" main.ed_name ") "
			optionarg opt.ed_lab
			option opt.ck_seq
		endoptions
	}
END
