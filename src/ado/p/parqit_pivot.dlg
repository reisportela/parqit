/*
  parqit collapse - Make a dataset of summary statistics, frequencies, or a
  pivot table; convert between wide and long

*!  VERSION 0.7.0  27oct2026

  User > parqit > Collapse, contract, pivot table, or reshape...
  Launch directly with:  db parqit_pivot      (menu installed by: parqit menu)

  Builds parqit collapse / pivot / contract / reshape. collapse and pivot
  share the statistic rows ((stat) [target=]source, exactly collapse's
  grammar); a pivot table additionally spreads one column per distinct
  value of the cols() variable, Excel-style. Populate fills the pickers
  from the selected view. Lazy: the view's plan changes, not the data in
  memory — materialise with parqit collect or parqit save.
*/

VERSION 16.0

INCLUDE _std_wide
DEFINE _dlght 395
INCLUDE header
HELP hlp1, view("help parqit##verbs")
RESET res1

SCRIPT PREINIT
BEGIN
	create STRING dlgname
	dlgname.storeDialogClassName
	create DOUBLE pq_populate_error
	create DOUBLE pq_refreshing
	create STRING pq_view_name
	create STRING pq_target_kind
END

PROGRAM POSTINIT_PROGRAM
BEGIN
	call program main_mode
	call program main_context
END

DIALOG main, label("parqit collapse - Make a dataset of summary statistics, frequencies, or a pivot table; reshape") ///
	tabtitle("Main")
BEGIN
  TEXT tx_view _lft _top 35 ., label("View:")
  COMBOBOX cb_view 55 @ 535 ., dropdownlist nomemory contents(view_list) ///
	default("(select a view)") onselchange(program main_target) label("View")
  RADIO rb_collapse		_lft	45	130	.,		///
	first								///
	onclickon(program main_mode)					///
	label("Collapse")
  RADIO rb_pivot		150	@	130	.,		///
	onclickon(program main_mode)					///
	label("Pivot table")
  RADIO rb_contract		290	@	130	.,		///
	onclickon(program main_mode)					///
	label("Contract")
  RADIO rb_reshape		430	@	130	.,		///
	last								///
	onclickon(program main_mode)					///
	label("Reshape")

  GROUPBOX gb_stats		_lft	75	_iwd	_ht9,		///
	label("Statistics to compute (collapse and pivot table)")
  TEXT tx_stat			_ilft	95	120	.,		///
	label("Statistic")
  TEXT tx_val			150	@	200	.,		///
	label("Of variable")
  TEXT tx_tgt			360	@	140	.,		///
	label("Result name (optional)")
  BUTTON bu_pop			510	@	80	.,		///
	onpush(program main_populate)					///
	tooltip("Populate the comboboxes with the variable names of the selected view") ///
	label("Populate")
  COMBOBOX cb_stat1		_ilft	_ss	120	.,		///
	dropdownlist							///
	contents(stat_list)						///
	default("mean")							///
	label("Statistic 1")
  COMBOBOX cb_val1		150	@	200	.,		///
	dropdown							///
	contents(vv_list)						///
	label("Variable 1")
  EDIT ed_tgt1			360	@	140	.,		///
	max(32)								///
	label("Result name 1")
  COMBOBOX cb_stat2		_ilft	_ms	120	.,		///
	dropdownlist							///
	contents(stat_list)						///
	default("count")						///
	label("Statistic 2")
  COMBOBOX cb_val2		150	@	200	.,		///
	dropdown							///
	contents(vv_list)						///
	label("Variable 2")
  EDIT ed_tgt2			360	@	140	.,		///
	max(32)								///
	label("Result name 2")
  TEXT tx_specs			_ilft	_ms	200	.,		///
	label("Additional specifications:")
  EDIT ed_specs			230	@	330	.,		///
	label("(stat) [target=]source ...")

  TEXT tx_by			_lft	205	_cwd1	.,		///
	label("Group by, option by() (collapse; optional):")
  TEXT tx_rows			_lft2	@	_cwd1	.,		///
	label("Rows of the pivot table, option rows():")
  COMBOBOX cb_by			_lft	_ss	_cwd1	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	option(by)							///
	label("Group by")
  COMBOBOX cb_rows		_lft2	@	_cwd1	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	option(rows)							///
	error("Rows of the pivot table")				///
	label("Rows of the pivot table")
  TEXT tx_cols			_lft	_ls	_iwd	.,		///
	label("Columns of the pivot table, option cols() (one variable; one output column per distinct value):")
  COMBOBOX cb_cols		_lft	_ss	_vnwd	.,		///
	dropdown							///
	contents(vv_list)						///
	option(cols)							///
	error("Columns of the pivot table")				///
	label("Columns of the pivot table")

  TEXT tx_note			_lft	_ls	_iwd	.,		///
	label("All four operations are lazy; materialise the result with parqit collect or parqit save.")
  TEXT tx_context _lft 355 470 ., label("Current view: refresh to check")
  BUTTON bu_context _rj80 @ 80 ., label("Refresh") onpush(program main_populate)
END

DIALOG opt, tabtitle("Contract, reshape and rows")
BEGIN
  TEXT tx_cvars			_lft	_top	_cwd1	.,		///
	label("Variables to contract:")
  TEXT tx_freq			_lft2	@	_cwd1	.,		///
	label("Name of frequency variable (optional; default _freq):")
  COMBOBOX cb_cvars		_lft	_ss	_cwd1	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("Variables to contract")					///
	label("Variables to contract")
  EDIT ed_freq			_lft2	@	_vnwd	.,		///
	max(32)								///
	option(freq)							///
	label("Name of frequency variable")

  TEXT tx_dir			_lft	_ls	120	.,		///
	label("Reshape to:")
  TEXT tx_stubs			140	@	220	.,		///
	label("Base (stub) names of X_ij variables:")
  TEXT tx_i			370	@	110	.,		///
	label("ID variables, i():")
  TEXT tx_j			490	@	100	.,		///
	label("j() variable:")
  COMBOBOX cb_dir		_lft	_ss	120	.,		///
	dropdownlist							///
	contents(dir_list)						///
	default("long")							///
	label("Reshape to")
  COMBOBOX cb_stubs		140	@	220	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("Base (stub) names")					///
	label("Base (stub) names")
  COMBOBOX cb_i			370	@	110	.,		///
	append								///
	dropdown							///
	contents(vv_list)						///
	error("ID variables")						///
	label("ID variables")
  COMBOBOX cb_j			490	@	100	.,		///
	dropdown							///
	contents(vv_list)						///
	error("j() variable")						///
	label("j() variable")

  TEXT tx_if _lft _ls _iwd ., ///
	label("If (expression) for collapse, pivot table, and contract (optional):")
  EXP ex_if @ _ss @ ., label("Create...")

END

DIALOG agg, label("Collapse options") tabtitle("Collapse options")
BEGIN
  TEXT tx_weight 15 10 95 ., label("Weight type:")
  COMBOBOX cb_wtype 15 28 95 ., dropdownlist contents(weight_list) default("fweight") label("Weight type")
  TEXT tx_weight_exp 120 10 470 ., label("Weight expression (blank for no weights):")
  EDIT ed_weight 120 28 470 ., label("Weight expression")
  CHECKBOX ck_cw 15 65 180 ., label("Complete cases (cw)") option(cw)
  CHECKBOX ck_unsorted 215 @ 165 ., label("Unsorted result") option(unsorted)
  CHECKBOX ck_wildparse 405 @ 185 ., label("Wildcard target names") option(wildparse)
  CHECKBOX ck_merge 15 95 180 ., label("Merge statistics into view") option(merge)
  CHECKBOX ck_replace 215 @ 165 ., label("Replace existing targets") option(replace)
  CHECKBOX ck_noinit 405 @ 185 ., label("Keep values outside sample") option(noinit)
  CHECKBOX ck_double 15 125 180 ., label("Store targets as double") option(double)
  CHECKBOX ck_sumcheck 215 @ 230 ., label("Pack integer sums (sumcheck)") option(sumcheck)
  TEXT tx_in 15 160 260 ., label("Observation range, in (optional; e.g. 2/50):")
  EDIT ed_in 15 178 260 ., label("Observation range")
  TEXT tx_freq 305 160 285 ., label("Group frequency variable (optional):")
  EDIT ed_freq 305 178 285 ., option(freq) label("Frequency variable")
  TEXT tx_rawstat 15 211 575 ., label("Targets to compute without weights, rawstat() (optional):")
  EDIT ed_rawstat 15 229 575 ., option(rawstat) label("Unweighted targets")
  TEXT tx_label 15 261 575 ., label("Label format (optional; #stat#, #sourcelabel#, #stat:pretty#):")
  EDIT ed_label 15 279 575 ., option(labelformat) label("Label format")
  TEXT tx_labelprogram 15 311 575 ., label("Label program returning r(prettystat) (optional):")
  EDIT ed_labelprogram 15 329 575 ., option(labelprogram) label("Label program")
END

LIST weight_list
BEGIN
    fweight
    aweight
    iweight
    pweight
END

PROGRAM main_context
BEGIN
	put "parqit _dlgviews "
	put dlgname
	put ", initial"
	stata hidden queue
	clear
END

LIST view_list
BEGIN
	(select a view)
END

PROGRAM main_refresh
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		stata hidden queue
		clear
	}
END

PROGRAM main_target
BEGIN
	if !pq_refreshing {
		put "parqit _dlgviews "
		put dlgname
		put ", target"
		stata hidden queue
		clear
	}
END

PROGRAM main_require
BEGIN
	if !main.cb_view | main.cb_view.iseq("(select a view)") {
		stopbox stop "Select an open view. Click Refresh to update the list."
	}
END

LIST vv_list
BEGIN
END

LIST dir_list
BEGIN
	long
	wide
END

LIST stat_list
BEGIN
	mean
	sum
	rawsum
	count
	unique
	nunique
	percent
	min
	max
	sd
	semean
	sebinomial
	sepoisson
	median
	iqr
	geomean
	nmissing
	nansum
	rawnansum
	variance
	cv
	skewness
	kurtosis
	range
	select1
	select-1
	rawselect1
	rawselect-1
	gini
	gini dropneg
	gini keepneg
	p10
	p25
	p50
	p75
	p90
	first
	last
	firstnm
	lastnm
END

PROGRAM main_mode
BEGIN
	call main.tx_stat.disable
	call main.tx_val.disable
	call main.tx_tgt.disable
	call main.cb_stat1.disable
	call main.cb_val1.disable
	call main.ed_tgt1.disable
	call main.cb_stat2.disable
	call main.cb_val2.disable
	call main.ed_tgt2.disable
	call main.tx_specs.disable
	call main.ed_specs.disable
	call main.tx_by.disable
	call main.cb_by.disable
	call main.tx_rows.disable
	call main.cb_rows.disable
	call main.tx_cols.disable
	call main.cb_cols.disable
	call opt.tx_cvars.disable
	call opt.cb_cvars.disable
	call opt.tx_freq.disable
	call opt.ed_freq.disable
	call opt.tx_dir.disable
	call opt.cb_dir.disable
	call opt.tx_stubs.disable
	call opt.cb_stubs.disable
	call opt.tx_i.disable
	call opt.cb_i.disable
	call opt.tx_j.disable
	call opt.cb_j.disable
	call opt.tx_if.disable
	call opt.ex_if.disable
	call agg.cb_wtype.disable
	call agg.ed_weight.disable
	call agg.ck_cw.disable
	call agg.ck_unsorted.disable
	call agg.ck_wildparse.disable
	call agg.ck_merge.disable
	call agg.ck_replace.disable
	call agg.ck_noinit.disable
	call agg.ck_double.disable
	call agg.ck_sumcheck.disable
	call agg.ed_in.disable
	call agg.ed_freq.disable
	call agg.ed_rawstat.disable
	call agg.ed_label.disable
	call agg.ed_labelprogram.disable
	if main.rb_collapse | main.rb_pivot {
		call opt.tx_if.enable
		call opt.ex_if.enable
		call main.tx_stat.enable
		call main.tx_val.enable
		call main.tx_tgt.enable
		call main.cb_stat1.enable
		call main.cb_val1.enable
		call main.ed_tgt1.enable
		call main.cb_stat2.enable
		call main.cb_val2.enable
		call main.ed_tgt2.enable
		call main.tx_specs.enable
		call main.ed_specs.enable
	}
	if main.rb_collapse {
		call main.tx_by.enable
		call main.cb_by.enable
		call agg.cb_wtype.enable
		call agg.ed_weight.enable
		call agg.ck_cw.enable
		call agg.ck_unsorted.enable
		call agg.ck_wildparse.enable
		call agg.ck_merge.enable
		call agg.ck_replace.enable
		call agg.ck_noinit.enable
		call agg.ck_double.enable
		call agg.ck_sumcheck.enable
		call agg.ed_in.enable
		call agg.ed_freq.enable
		call agg.ed_rawstat.enable
		call agg.ed_label.enable
		call agg.ed_labelprogram.enable
	}
	if main.rb_pivot {
		call main.tx_rows.enable
		call main.cb_rows.enable
		call main.tx_cols.enable
		call main.cb_cols.enable
	}
	if main.rb_contract {
		call opt.tx_if.enable
		call opt.ex_if.enable
		call opt.tx_cvars.enable
		call opt.cb_cvars.enable
		call opt.tx_freq.enable
		call opt.ed_freq.enable
	}
	if main.rb_reshape {
		call opt.tx_dir.enable
		call opt.cb_dir.enable
		call opt.tx_stubs.enable
		call opt.cb_stubs.enable
		call opt.tx_i.enable
		call opt.cb_i.enable
		call opt.tx_j.enable
		call opt.cb_j.enable
	}
END

PROGRAM main_populate
BEGIN
	call program main_refresh
END

PROGRAM main_stats_output
BEGIN
	if main.cb_val1 {
		put " (" main.cb_stat1 ") "
		if main.ed_tgt1 {
			put main.ed_tgt1 "="
		}
		put main.cb_val1
	}
	if main.cb_val2 {
		put " (" main.cb_stat2 ") "
		if main.ed_tgt2 {
			put main.ed_tgt2 "="
		}
		put main.cb_val2
	}
	if main.ed_specs {
		put " " main.ed_specs
	}
END

PROGRAM command
BEGIN
	call program main_require
	if main.rb_collapse | main.rb_pivot {
		if !main.cb_val1 & !main.cb_val2 & !main.ed_specs {
			stopbox stop "At least one statistic with a variable (or an additional specification) must be given."
		}
	}
	if main.rb_collapse {
		put "parqit view " main.cb_view ": collapse "
		put /program main_stats_output
		if opt.ex_if {
			put " if " opt.ex_if
		}
		if agg.ed_in {
			put " in " agg.ed_in
		}
		if agg.ed_weight {
			put " [" agg.cb_wtype "=" agg.ed_weight "]"
		}
		beginoptions
			optionarg main.cb_by
			option agg.ck_cw
			option agg.ck_unsorted
			option agg.ck_wildparse
			option agg.ck_merge
			option agg.ck_replace
			option agg.ck_noinit
			option agg.ck_double
			option agg.ck_sumcheck
			optionarg agg.ed_freq
			optionarg agg.ed_rawstat
			optionarg /quoted agg.ed_label
			optionarg agg.ed_labelprogram
		endoptions
	}
	if main.rb_pivot {
		require main.cb_rows
		require main.cb_cols
		put "parqit view " main.cb_view ": pivot "
		put /program main_stats_output
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg main.cb_rows
			optionarg main.cb_cols
		endoptions
	}
	if main.rb_contract {
		require opt.cb_cvars
		put "parqit view " main.cb_view ": contract " opt.cb_cvars
		if opt.ex_if {
			put " if " opt.ex_if
		}
		beginoptions
			optionarg opt.ed_freq
		endoptions
	}
	if main.rb_reshape {
		require opt.cb_stubs
		require opt.cb_i
		require opt.cb_j
		put "parqit view " main.cb_view ": reshape " opt.cb_dir " " opt.cb_stubs
		beginoptions
			put "i(" opt.cb_i ") "
			put "j(" opt.cb_j ")"
		endoptions
	}
END
