# Retain only corrections not yet present in DuckDB 2.0.0. Never accept a
# source change merely because its context still happens to match.
include("${CMAKE_CURRENT_LIST_DIR}/ReadPinnedSource.cmake")
function(parqit_duckdb200_source relative original_hash corrected_hash)
    set(path "${duckdb_SOURCE_DIR}/${relative}")
    parqit_read_pinned_source("${path}" contents actual_hash)
    if(actual_hash STREQUAL corrected_hash)
        return()
    endif()
    if(NOT actual_hash STREQUAL original_hash)
        message(FATAL_ERROR "Unexpected DuckDB 2.0 source; preserving local changes: ${relative}")
    endif()
    set(index 3)
    while(index LESS ARGC)
        set(arg "ARGV${index}")
        set(before "${${arg}}")
        math(EXPR index "${index}+1")
        set(arg "ARGV${index}")
        set(after "${${arg}}")
        string(REPLACE "${before}" "${after}" contents "${contents}")
        math(EXPR index "${index}+1")
    endwhile()
    string(SHA256 corrected "${contents}")
    if(NOT corrected STREQUAL corrected_hash)
        message(FATAL_ERROR "DuckDB 2.0 correction hash differs: ${relative}")
    endif()
    set(staging "${path}.parqit-200-patch")
    if(EXISTS "${staging}")
        message(FATAL_ERROR "Existing DuckDB 2.0 staging preserved: ${staging}")
    endif()
    file(WRITE "${staging}" "${contents}")
    parqit_verify_pinned_write("${staging}" "${corrected_hash}")
    file(RENAME "${staging}" "${path}")
    parqit_verify_pinned_write("${path}" "${corrected_hash}")
    message(STATUS "Applied parqit DuckDB 2.0 correction: ${relative}")
endfunction()
include("${CMAKE_CURRENT_LIST_DIR}/DuckDB200Sources.cmake")
