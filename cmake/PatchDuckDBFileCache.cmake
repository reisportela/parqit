# PARQIT-CACHE-IDENTITY: the optional 1.5.6 build needs source-generation guards too.
include("${CMAKE_CURRENT_LIST_DIR}/ReadPinnedSource.cmake")
function(parqit_patch_duckdb_file_cache relative original_hash corrected_hash)
    set(path "${duckdb_SOURCE_DIR}/${relative}")
    parqit_read_pinned_source("${path}" contents actual_hash)
    if(actual_hash STREQUAL corrected_hash)
        return()
    endif()
    if(NOT actual_hash STREQUAL original_hash)
        message(FATAL_ERROR "Unexpected DuckDB file-cache source; preserving local changes: ${relative}")
    endif()
    set(index 3)
    while(index LESS ARGC)
        set(arg "ARGV${index}")
        set(before "${${arg}}")
        math(EXPR index "${index}+1")
        set(arg "ARGV${index}")
        string(REPLACE "${before}" "${${arg}}" contents "${contents}")
        math(EXPR index "${index}+1")
    endwhile()
    string(SHA256 corrected "${contents}")
    if(NOT corrected STREQUAL corrected_hash)
        message(FATAL_ERROR "DuckDB file-cache correction hash differs: ${relative}")
    endif()
    set(staging "${path}.parqit-file-cache-patch")
    if(EXISTS "${staging}")
        message(FATAL_ERROR "Existing DuckDB file-cache staging preserved: ${staging}")
    endif()
    file(WRITE "${staging}" "${contents}")
    parqit_verify_pinned_write("${staging}" "${corrected_hash}")
    file(RENAME "${staging}" "${path}")
    parqit_verify_pinned_write("${path}" "${corrected_hash}")
    message(STATUS "Applied parqit DuckDB file-cache correction: ${relative}")
endfunction()
include("${CMAKE_CURRENT_LIST_DIR}/DuckDB156FileCache.cmake")
