# Reconstruct the three upstream 1.5.6 sources and exercise the production guard.
cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)
set(cache_scratch "${scratch}/file_cache")
function(parqit_patch_duckdb_file_cache relative original_hash corrected_hash)
    file(READ "${DUCKDB_SOURCE_DIR}/${relative}" fixed)
    string(REPLACE "\r\n" "\n" fixed "${fixed}")
    string(SHA256 hash "${fixed}")
    if(NOT hash STREQUAL corrected_hash)
        message(FATAL_ERROR "File-cache fixture is not the corrected source: ${relative}")
    endif()
    set(original "${fixed}")
    math(EXPR index "${ARGC}-2")
    while(index GREATER_EQUAL 3)
        set(arg "ARGV${index}")
        set(before "${${arg}}")
        math(EXPR after_index "${index}+1")
        set(arg "ARGV${after_index}")
        string(REPLACE "${${arg}}" "${before}" original "${original}")
        math(EXPR index "${index}-2")
    endwhile()
    string(SHA256 hash "${original}")
    if(NOT hash STREQUAL original_hash)
        message(FATAL_ERROR "File-cache upstream reconstruction differs: ${relative}")
    endif()
    get_filename_component(parent "${cache_scratch}/original/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${cache_scratch}/original/${relative}" "${original}")
    set_property(GLOBAL APPEND PROPERTY cache_sources "${relative}")
    set_property(GLOBAL PROPERTY "cache_fixed_${relative}" "${corrected_hash}")
endfunction()
include("${PARQIT_SOURCE_DIR}/cmake/DuckDB156FileCache.cmake")
get_property(cache_sources GLOBAL PROPERTY cache_sources)
set(cache_index 0)
foreach(cache_source IN LISTS cache_sources)
    math(EXPR cache_index "${cache_index}+1")
    foreach(mode lf crlf unknown mixed staging)
        if(WIN32 AND mode MATCHES "^(crlf|mixed)$")
            continue()
        endif()
        set(root "${cache_scratch}/${cache_index}_${mode}")
        file(MAKE_DIRECTORY "${root}")
        file(COPY "${cache_scratch}/original/" DESTINATION "${root}")
        set(path "${root}/${cache_source}")
        if(mode STREQUAL "unknown")
            file(APPEND "${path}" "\n// unrelated local edit\n")
        elseif(mode STREQUAL "staging")
            file(WRITE "${path}.parqit-file-cache-patch" "preserve this staging")
        elseif(mode STREQUAL "crlf")
            file(READ "${path}" contents)
            string(REPLACE "\n" "\r\n" contents "${contents}")
            file(WRITE "${path}" "${contents}")
        elseif(mode STREQUAL "mixed")
            file(APPEND "${path}" "// mixed line ending\r\n")
        endif()
        file(SHA256 "${path}" before)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-Dduckdb_SOURCE_DIR=${root}"
            -P "${PARQIT_SOURCE_DIR}/cmake/PatchDuckDBFileCache.cmake"
            RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
        if(mode MATCHES "^(unknown|mixed|staging)$")
            file(SHA256 "${path}" after)
            if(status EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "Unexpected DuckDB|Existing DuckDB"
                    OR NOT before STREQUAL after)
                message(FATAL_ERROR "File-cache ${cache_index}/${mode} did not preserve/refuse: ${stdout}${stderr}")
            endif()
            if(mode STREQUAL "staging")
                file(READ "${path}.parqit-file-cache-patch" contents)
                if(NOT contents STREQUAL "preserve this staging")
                    message(FATAL_ERROR "File-cache staging was changed")
                endif()
            endif()
        else()
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "File-cache ${cache_index}/${mode} failed: ${stdout}${stderr}")
            endif()
            foreach(source IN LISTS cache_sources)
                file(READ "${root}/${source}" contents)
                string(REPLACE "\r\n" "\n" contents "${contents}")
                string(SHA256 hash "${contents}")
                get_property(expected GLOBAL PROPERTY "cache_fixed_${source}")
                if(NOT hash STREQUAL expected)
                    message(FATAL_ERROR "File-cache corrected bytes differ: ${source}")
                endif()
                if(mode STREQUAL "crlf")
                    string(REPLACE "\n" "\r\n" contents "${contents}")
                    file(WRITE "${root}/${source}" "${contents}")
                endif()
                file(SHA256 "${root}/${source}" "before_${source}")
            endforeach()
            execute_process(COMMAND "${CMAKE_COMMAND}" "-Dduckdb_SOURCE_DIR=${root}"
                -P "${PARQIT_SOURCE_DIR}/cmake/PatchDuckDBFileCache.cmake"
                RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "File-cache idempotence failed: ${stdout}${stderr}")
            endif()
            foreach(source IN LISTS cache_sources)
                file(SHA256 "${root}/${source}" after)
                if(NOT after STREQUAL "${before_${source}}")
                    message(FATAL_ERROR "File-cache idempotence changed physical bytes")
                endif()
            endforeach()
        endif()
        message(STATUS "PATCH_GUARD_PASS file_cache_${cache_index}_${mode}")
    endforeach()
endforeach()
cmake_policy(POP)
