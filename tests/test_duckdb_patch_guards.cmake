# Exercise production patch scripts only on private copies of pinned sources.
foreach(required PARQIT_SOURCE_DIR DUCKDB_SOURCE_DIR TEST_BINARY_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(scratch "${TEST_BINARY_DIR}/Testing/patch_guards_${nonce}")
if(EXISTS "${scratch}")
    message(FATAL_ERROR "Refusing an existing patch-test directory")
endif()
file(MAKE_DIRECTORY "${scratch}")

function(remove_between text first last output)
    string(FIND "${text}" "${first}" begin)
    string(FIND "${text}" "${last}" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Pinned test source no longer has its expected markers")
    endif()
    string(SUBSTRING "${text}" 0 ${begin} prefix)
    string(SUBSTRING "${text}" ${end} -1 suffix)
    set(${output} "${prefix}${suffix}" PARENT_SCOPE)
endfunction()

function(check_case name patch relative source expected_hash expected_error staging)
    set(root "${scratch}/${name}")
    set(path "${root}/${relative}")
    get_filename_component(parent "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${path}" "${source}")
    file(SHA256 "${path}" before_hash)
    if(NOT staging STREQUAL "")
        file(WRITE "${path}${staging}" "existing staging must survive")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-Dduckdb_SOURCE_DIR=${root}"
        -P "${PARQIT_SOURCE_DIR}/cmake/${patch}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(expected_error STREQUAL "")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name} failed: ${stdout}${stderr}")
        endif()
    elseif(status EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "${expected_error}")
        message(FATAL_ERROR "${name} did not give its expected refusal: ${status}: ${stdout}${stderr}")
    endif()
    file(SHA256 "${path}" after_hash)
    if(NOT expected_error STREQUAL "" OR name MATCHES "idempotent")
        if(NOT before_hash STREQUAL after_hash)
            message(FATAL_ERROR "${name} did not preserve the original physical bytes")
        endif()
    endif()
    file(READ "${path}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    string(SHA256 actual_hash "${actual}")
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "${name} changed unexpected bytes")
    endif()
    if(NOT staging STREQUAL "")
        file(READ "${path}${staging}" staged)
        if(NOT staged STREQUAL "existing staging must survive")
            message(FATAL_ERROR "${name} damaged pre-existing staging")
        endif()
    endif()
    message(STATUS "PATCH_GUARD_PASS ${name}")
endfunction()

set(window_path "src/optimizer/window_self_join.cpp")
file(READ "${DUCKDB_SOURCE_DIR}/${window_path}" window_fixed)
string(REPLACE "\r\n" "\n" window_fixed "${window_fixed}")
set(window_fixed_hash "9666fa348eec85dc76341819a5e599d0e1d1c4b3128416ccf85553d7c96ef104")
string(SHA256 hash "${window_fixed}")
if(NOT hash STREQUAL window_fixed_hash)
    message(FATAL_ERROR "Window fixture is not the pinned corrected source")
endif()
string(REPLACE "\tcase LogicalOperatorType::LOGICAL_PROJECTION:\n"
    "\tcase LogicalOperatorType::LOGICAL_PROJECTION:\n\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY:\n"
    window_intermediate "${window_fixed}")
string(SHA256 hash "${window_intermediate}")
if(NOT hash STREQUAL "797752375813fc3d96b2a4c0130e80fe3856cfc1a31ff13ac273fb5d7f41210c")
    message(FATAL_ERROR "Intermediate window fixture hash differs")
endif()
remove_between("${window_intermediate}" "// PARQIT-WINDOW-VOLATILE-1:"
    "static unique_ptr<Expression> TranslateAggregate" window_original)
string(REPLACE "#include \"duckdb/planner/logical_operator_visitor.hpp\"\n" ""
    window_original "${window_original}")
string(REPLACE " || ParqitHasVolatileWindowInput(*window.children[0])" ""
    window_original "${window_original}")
string(REPLACE "w_expr.IsVolatile() || " "" window_original "${window_original}")
set(window_original_hash "e425667854d29c6337626f949e7f4941c5289ea9dc4b4bef92e229b2a662f6a4")
string(SHA256 hash "${window_original}")
if(NOT hash STREQUAL window_original_hash)
    message(FATAL_ERROR "Reconstructed upstream window source hash differs")
endif()
check_case(window_original PatchDuckDBWindowSelfJoin.cmake "${window_path}"
    "${window_original}" "${window_fixed_hash}" "" "")
check_case(window_intermediate PatchDuckDBWindowSelfJoin.cmake "${window_path}"
    "${window_intermediate}" "${window_fixed_hash}" "" "")
check_case(window_idempotent PatchDuckDBWindowSelfJoin.cmake "${window_path}"
    "${window_fixed}" "${window_fixed_hash}" "" "")
set(unknown "${window_original}\n// unknown local change\n")
string(SHA256 unknown_hash "${unknown}")
check_case(window_unknown PatchDuckDBWindowSelfJoin.cmake "${window_path}"
    "${unknown}" "${unknown_hash}" "Unexpected DuckDB" "")
check_case(window_staging PatchDuckDBWindowSelfJoin.cmake "${window_path}"
    "${window_original}" "${window_original_hash}" "Existing DuckDB" ".parqit-window-patch")

set(lambda_path "src/planner/expression/bound_function_expression.cpp")
file(READ "${DUCKDB_SOURCE_DIR}/${lambda_path}" lambda_fixed)
string(REPLACE "\r\n" "\n" lambda_fixed "${lambda_fixed}")
set(lambda_fixed_hash "6cace450998dd5deae9de93e722004f354b3577fc53aae2ee6e842a86f55fd49")
string(SHA256 hash "${lambda_fixed}")
if(NOT hash STREQUAL lambda_fixed_hash)
    message(FATAL_ERROR "Lambda fixture is not the pinned corrected source")
endif()
remove_between("${lambda_fixed}" "\t// PARQIT-LAMBDA-VOLATILE-1:"
    "\treturn function.GetStability()" lambda_original)
set(lambda_original_hash "e4d2ed917ba3d114008f12f3fa10895b3c4957c98405bd4084adccfbca9b2a89")
string(SHA256 hash "${lambda_original}")
if(NOT hash STREQUAL lambda_original_hash)
    message(FATAL_ERROR "Reconstructed upstream lambda source hash differs")
endif()
check_case(lambda_original PatchDuckDBLambdaVolatility.cmake "${lambda_path}"
    "${lambda_original}" "${lambda_fixed_hash}" "" "")
check_case(lambda_idempotent PatchDuckDBLambdaVolatility.cmake "${lambda_path}"
    "${lambda_fixed}" "${lambda_fixed_hash}" "" "")
set(unknown "${lambda_original}\n// unknown local change\n")
string(SHA256 unknown_hash "${unknown}")
check_case(lambda_unknown PatchDuckDBLambdaVolatility.cmake "${lambda_path}"
    "${unknown}" "${unknown_hash}" "Unexpected DuckDB" "")
check_case(lambda_staging PatchDuckDBLambdaVolatility.cmake "${lambda_path}"
    "${lambda_original}" "${lambda_original_hash}" "Existing DuckDB" ".parqit-lambda-patch")

# Windows' native writes already exercise CRLF. On Unix, construct those
# physical bytes explicitly as a second encoding of each pinned source.
if(NOT WIN32)
    foreach(kind window lambda)
        string(REPLACE "\n" "\r\n" crlf "${${kind}_original}")
        if(kind STREQUAL "window")
            set(patch PatchDuckDBWindowSelfJoin.cmake)
        else()
            set(patch PatchDuckDBLambdaVolatility.cmake)
        endif()
        check_case(${kind}_crlf ${patch} "${${kind}_path}"
            "${crlf}" "${${kind}_fixed_hash}" "" "")
        string(REPLACE "\n" "\r\n" crlf "${${kind}_fixed}")
        check_case(${kind}_crlf_idempotent ${patch} "${${kind}_path}"
            "${crlf}" "${${kind}_fixed_hash}" "" "")
        string(FIND "${${kind}_original}" "\n" first_newline)
        string(SUBSTRING "${${kind}_original}" 0 ${first_newline} prefix)
        math(EXPR rest "${first_newline}+1")
        string(SUBSTRING "${${kind}_original}" ${rest} -1 suffix)
        check_case(${kind}_mixed_refusal ${patch} "${${kind}_path}"
            "${prefix}\r\n${suffix}" "${${kind}_original_hash}" "Unexpected DuckDB" "")
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/test_duckdb_file_cache_guards.cmake")
