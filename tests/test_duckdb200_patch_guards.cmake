# Exercise each reviewed 2.0 source on private fixtures, including upstream
# corrections that now require verification rather than another local patch.
foreach(required PARQIT_SOURCE_DIR DUCKDB_SOURCE_DIR TEST_BINARY_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(scratch "${TEST_BINARY_DIR}/Testing/duckdb200_guards_${nonce}")
if(EXISTS "${scratch}")
    message(FATAL_ERROR "Refusing an existing patch-test directory")
endif()
file(MAKE_DIRECTORY "${scratch}/original")

function(parqit_duckdb200_source relative original_hash corrected_hash)
    file(READ "${DUCKDB_SOURCE_DIR}/${relative}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(SHA256 actual_hash "${contents}")
    if(NOT actual_hash STREQUAL corrected_hash)
        message(FATAL_ERROR "Fixture is not the reviewed corrected source: ${relative}")
    endif()
    math(EXPR index "${ARGC}-2")
    while(index GREATER_EQUAL 3)
        set(arg "ARGV${index}")
        set(before "${${arg}}")
        math(EXPR after_index "${index}+1")
        set(arg "ARGV${after_index}")
        string(REPLACE "${${arg}}" "${before}" contents "${contents}")
        math(EXPR index "${index}-2")
    endwhile()
    string(SHA256 actual_hash "${contents}")
    if(NOT actual_hash STREQUAL original_hash)
        message(FATAL_ERROR "Reconstructed upstream hash differs: ${relative}")
    endif()
    set(path "${scratch}/original/${relative}")
    get_filename_component(parent "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${path}" "${contents}")
    set_property(GLOBAL APPEND PROPERTY sources "${relative}")
    set_property(GLOBAL PROPERTY "corrected_${relative}" "${corrected_hash}")
    if(NOT original_hash STREQUAL corrected_hash)
        set_property(GLOBAL APPEND PROPERTY changed_sources "${relative}")
    endif()
endfunction()
include("${PARQIT_SOURCE_DIR}/cmake/DuckDB200Sources.cmake")
get_property(sources GLOBAL PROPERTY sources)
get_property(changed_sources GLOBAL PROPERTY changed_sources)

function(check_case name mode relative)
    set(root "${scratch}/${name}")
    file(MAKE_DIRECTORY "${root}")
    file(COPY "${scratch}/original/" DESTINATION "${root}")
    if(mode STREQUAL "crlf")
        foreach(source IN LISTS sources)
            file(READ "${root}/${source}" contents)
            string(REPLACE "\n" "\r\n" contents "${contents}")
            file(WRITE "${root}/${source}" "${contents}")
        endforeach()
    elseif(mode STREQUAL "unknown")
        file(APPEND "${root}/${relative}" "\n// unrelated local edit\n")
    elseif(mode STREQUAL "mixed")
        file(READ "${root}/${relative}" contents)
        string(FIND "${contents}" "\n" end)
        string(SUBSTRING "${contents}" 0 ${end} first)
        math(EXPR end "${end}+1")
        string(SUBSTRING "${contents}" ${end} -1 rest)
        file(WRITE "${root}/${relative}" "${first}\r\n${rest}")
    elseif(mode STREQUAL "staging")
        file(WRITE "${root}/${relative}.parqit-200-patch" "existing staging must survive")
    endif()
    if(NOT relative STREQUAL "")
        file(SHA256 "${root}/${relative}" before_hash)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-Dduckdb_SOURCE_DIR=${root}"
        -P "${PARQIT_SOURCE_DIR}/cmake/PatchDuckDB200.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(mode MATCHES "^(unknown|mixed|staging)$")
        if(status EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "Unexpected DuckDB|Existing DuckDB")
            message(FATAL_ERROR "${name} did not refuse as expected: ${stdout}${stderr}")
        endif()
        file(SHA256 "${root}/${relative}" after_hash)
        if(NOT before_hash STREQUAL after_hash)
            message(FATAL_ERROR "${name} changed the refused source")
        endif()
        if(mode STREQUAL "staging")
            file(READ "${root}/${relative}.parqit-200-patch" staged)
            if(NOT staged STREQUAL "existing staging must survive")
                message(FATAL_ERROR "${name} damaged pre-existing staging")
            endif()
        endif()
    else()
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name} failed: ${stdout}${stderr}")
        endif()
        foreach(source IN LISTS sources)
            file(READ "${root}/${source}" contents)
            string(REPLACE "\r\n" "\n" canonical "${contents}")
            string(SHA256 actual_hash "${canonical}")
            get_property(expected GLOBAL PROPERTY "corrected_${source}")
            if(NOT actual_hash STREQUAL expected)
                message(FATAL_ERROR "${name} changed unexpected bytes: ${source}")
            endif()
            if(mode STREQUAL "crlf")
                string(REPLACE "\n" "\r\n" contents "${canonical}")
                file(WRITE "${root}/${source}" "${contents}")
            endif()
            file(SHA256 "${root}/${source}" "before_${source}")
        endforeach()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-Dduckdb_SOURCE_DIR=${root}"
            -P "${PARQIT_SOURCE_DIR}/cmake/PatchDuckDB200.cmake"
            RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name} reapplication failed: ${stdout}${stderr}")
        endif()
        foreach(source IN LISTS sources)
            file(SHA256 "${root}/${source}" actual_hash)
            if(NOT actual_hash STREQUAL "${before_${source}}")
                message(FATAL_ERROR "${name} idempotence changed physical bytes: ${source}")
            endif()
        endforeach()
    endif()
    message(STATUS "PATCH_GUARD_PASS ${name}")
endfunction()
check_case(upstream lf "")
if(NOT WIN32)
    check_case(windows_endings crlf "")
endif()
set(index 0)
foreach(source IN LISTS sources)
    math(EXPR index "${index}+1")
    check_case(unknown_${index} unknown "${source}")
    if(NOT WIN32)
        check_case(mixed_${index} mixed "${source}")
    endif()
endforeach()
foreach(source IN LISTS changed_sources)
    math(EXPR index "${index}+1")
    check_case(staging_${index} staging "${source}")
endforeach()
